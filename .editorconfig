root = true

[*.{cs,xaml}]
indent_style = space
indent_size = 4
# A guide, not a build rule: wrap lines before this.
max_line_length = 140

[*.cs]
# Unused code is a build warning, and warnings fail the build.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

[src/Shared/*.cs]
# These files compile into several projects, and each needs a different set of usings.
dotnet_diagnostic.IDE0005.severity = none
