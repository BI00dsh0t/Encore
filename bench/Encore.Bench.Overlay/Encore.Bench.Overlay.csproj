<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Story 5.2: the App's Overlay window, hosted on its own so bench overlay can show it over the GPU load. -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Per-monitor DPI aware, as the App is, so the dot is placed in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF, like the App: not built with the engine side's AOT analyzers. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Encore.Platform.Desktop\Encore.Platform.Desktop.csproj" />
  </ItemGroup>
</Project>
