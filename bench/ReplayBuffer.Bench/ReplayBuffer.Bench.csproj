<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The drift run's marker window. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- ffmpeg and ffprobe decode the captured file; the DLLs come along with them. -->
    <CopyFFmpegNative>true</CopyFFmpegNative>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReplayBuffer.Bench.Tests" />
    <!-- WinForms is only the marker window, which names its own usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ReplayBuffer.Contracts\ReplayBuffer.Contracts.csproj" />
    <ProjectReference Include="..\..\src\ReplayBuffer.Media\ReplayBuffer.Media.csproj" />
    <ProjectReference Include="..\..\src\ReplayBuffer.Platform.Audio\ReplayBuffer.Platform.Audio.csproj" />
  </ItemGroup>
</Project>
