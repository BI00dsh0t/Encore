<!--
    The Main App's shell (EXPERIENCE.md Shell layout): the nav pane with the brand, then the content
    column with the status header, the page header and the page. The theme's shell dictionary
    (ShellFluent or ShellGamingDark) supplies the nav and layer styles; every colour is a token.
-->
<app:ShellWindow x:Class="ReplayBuffer.App.MainWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:app="clr-namespace:ReplayBuffer.App"
                 x:Name="Shell"
                 Title="ReplayBuffer"
                 Width="960"
                 Height="600"
                 MinWidth="480"
                 MinHeight="320"
                 KeyDown="OnKeyDown"
                 SizeChanged="OnSizeChanged"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="{DynamicResource RbNavPanePadding}">
            <ContentControl x:Name="Brand"
                            Margin="{DynamicResource RbNavBrandMargin}"
                            Content="{Binding Title, ElementName=Shell}"
                            DockPanel.Dock="Top"
                            Style="{DynamicResource RbBrandStyle}" />
            <app:NavListBox x:Name="Nav"
                     Padding="0"
                     AutomationProperties.Name="Navigation"
                     Background="Transparent"
                     BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{DynamicResource RbNavItemStyle}"
                     ItemsSource="{Binding NavItems, Mode=OneTime}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     TextSearch.TextPath="Title" />
        </DockPanel>

        <Border Grid.Column="1" Style="{DynamicResource RbShellContentLayerStyle}">
            <DockPanel Margin="{DynamicResource RbPagePadding}">
                <ContentControl x:Name="StatusHeader"
                                Content="{Binding StatusLine.View}"
                                DockPanel.Dock="Top"
                                Focusable="False" />
                <ContentControl x:Name="PageTitle"
                                Margin="0,16,0,0"
                                Content="{Binding CurrentTitle}"
                                DockPanel.Dock="Top"
                                Style="{DynamicResource RbPageTitleStyle}" />
                <TextBlock x:Name="PageMessage"
                           Margin="0,12,0,0"
                           DockPanel.Dock="Bottom"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Text="{Binding SelectedPage.Message}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsTabSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ContentControl x:Name="Page"
                                Margin="0,12,0,0"
                                Content="{Binding CurrentView}"
                                Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</app:ShellWindow>
