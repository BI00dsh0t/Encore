<app:ShellWindow x:Class="ReplayBuffer.App.Library.ClipShortcutsDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:app="clr-namespace:ReplayBuffer.App" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
 WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="Timeline shortcuts">
 <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="8">
  <DockPanel KeyboardNavigation.TabNavigation="Cycle">
   <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" IsDefault="True" Click="CloseHelp" HorizontalAlignment="Right" Margin="0,18,0,0" Style="{DynamicResource RbClipButtonStyle}" />
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Timeline shortcuts" FontSize="20" FontWeight="Medium" Margin="0,0,0,16" />
    <TextBlock Text="P, then ← / →: seek ±1 ms" Margin="0,0,0,12" TextWrapping="Wrap" />
    <TextBlock Text="Home / End, then ← / →: trim In / Out ±1 ms" Margin="0,0,0,12" TextWrapping="Wrap" />
    <TextBlock Text="+ / − or wheel: zoom" Margin="0,0,0,12" TextWrapping="Wrap" />
    <TextBlock Text="Shift + wheel: pan" Margin="0,0,0,12" TextWrapping="Wrap" />
    <TextBlock Text="↑ / ↓ / Page Up / Page Down: scroll audio lanes" Margin="0,0,0,12" TextWrapping="Wrap" />
    <TextBlock Text="Double-click a waveform to select the visible range, rounded inward to milliseconds." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Border>
</app:ShellWindow>
