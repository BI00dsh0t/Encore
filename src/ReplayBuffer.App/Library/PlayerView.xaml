<!--
    The in-app player's page (story 14.2, AD-27): the video fills the page under the breadcrumb, letterboxed with
    its aspect kept, and a bar over its bottom edge holds the controls. The picture is a WPF D3DImage, so the bar
    and the looks draw over it. 14.4 adds the Track list and 14.5 the transport to the bar.
-->
<UserControl x:Class="ReplayBuffer.App.Library.PlayerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:EmptyToCollapsedConverter x:Key="NotEmpty" />
    </UserControl.Resources>
    <Border Style="{DynamicResource RbPlayerBackdropStyle}">
        <Grid>
            <Image x:Name="Picture" Stretch="Uniform" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{DynamicResource RbPlayerMessageStyle}"
                       Text="{Binding Message}"
                       Visibility="{Binding Message, Converter={StaticResource NotEmpty}}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{DynamicResource RbPlayerBarStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayPause"
                            MinWidth="88"
                            VerticalAlignment="Center"
                            Command="{Binding PlayPauseCommand}"
                            Content="{Binding PlayPauseLabel}" />
                    <Button Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding OpenInDefaultPlayerCommand}"
                            Content="Open in default player"
                            Visibility="{Binding IsFailed, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
