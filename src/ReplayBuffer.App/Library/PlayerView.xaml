<!--
    The in-app player's page (stories 14.2 to 14.7, restyled in 14.9 after the builder's approved mockup, AD-27).
    The video fills the page, letterboxed with its aspect kept; under it (over it, in full screen) one thin
    full-width seek bar sits above a single control row:
      left: Play or Pause; the speaker, which mutes on click, with the volume slider sliding out on hover or
            keyboard focus; then the time, elapsed / total;
      right: the gear, whose menu lists the Tracks under "Audio track" (the playing one ticked) and then
             "Open in default player"; then full screen.
    The picture is a WPF D3DImage, so the bar and the looks draw over it. Keys bubble to the page (KeyDown, not
    PreviewKeyDown), so a focused control's own keys win. Every colour is a token (LibraryTheme.xaml).
-->
<UserControl x:Class="ReplayBuffer.App.Library.PlayerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ReplayBuffer.App.Theme"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:EmptyToCollapsedConverter x:Key="NotEmpty" />
    </UserControl.Resources>
    <Border x:Name="Backdrop" Style="{DynamicResource RbPlayerBackdropStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="Picture" Stretch="Uniform" />
            <TextBlock MaxWidth="560"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{DynamicResource RbPlayerMessageStyle}"
                       Text="{Binding Message}"
                       Visibility="{Binding Message, Converter={StaticResource NotEmpty}}" />

            <!-- The bar: under the video, or over its bottom edge in full screen (RbPlayerBarStyle). -->
            <Border x:Name="Bar" Grid.Row="1" Style="{DynamicResource RbPlayerBarStyle}">
                <StackPanel>
                    <Slider x:Name="SeekBar"
                            AutomationProperties.Name="Seek"
                            IsMoveToPointEnabled="True"
                            LargeChange="30"
                            Maximum="{Binding DurationSeconds}"
                            Minimum="0"
                            SmallChange="5"
                            Style="{DynamicResource RbPlayerSeekStyle}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            Visibility="{Binding CanSeek, Converter={StaticResource Visible}}" />
                    <DockPanel Height="48" LastChildFill="False">
                        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="PlayPause"
                                    AutomationProperties.Name="{Binding PlayPauseLabel}"
                                    Command="{Binding PlayPauseCommand}"
                                    Content="{Binding PlayPauseGlyph}"
                                    Style="{DynamicResource RbPlayerIconButtonStyle}"
                                    ToolTip="{Binding PlayPauseLabel}" />
                            <!-- The speaker; its slider slides out while the pointer or keyboard focus is in this group. -->
                            <StackPanel x:Name="VolumeGroup"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasControls, Converter={StaticResource Visible}}">
                                <Button x:Name="Mute"
                                        AutomationProperties.Name="{Binding MuteName}"
                                        Command="{Binding MuteCommand}"
                                        Content="{Binding MuteGlyph}"
                                        Style="{DynamicResource RbPlayerIconButtonStyle}"
                                        ToolTip="{Binding MuteName}" />
                                <Slider x:Name="VolumeBar"
                                        Width="72"
                                        Margin="6,0,6,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Volume"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="0.2"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.05"
                                        Style="{DynamicResource RbPlayerVolumeStyle}"
                                        Value="{Binding Volume, Mode=TwoWay}"
                                        Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="Time"
                                       Margin="8,0,0,0"
                                       Style="{DynamicResource RbPlayerTimeStyle}"
                                       Text="{Binding TimeText}"
                                       Visibility="{Binding HasControls, Converter={StaticResource Visible}}" />
                            <!-- Story 14.6: the missing extension's Store page, then the default player, when it can't play. -->
                            <Button Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenStoreCommand}"
                                    Content="{Binding StoreLinkText}"
                                    Visibility="{Binding HasStoreLink, Converter={StaticResource Visible}}" />
                            <Button Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenInDefaultPlayerCommand}"
                                    Content="Open in default player"
                                    Visibility="{Binding IsFailed, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton x:Name="Gear"
                                          AutomationProperties.Name="Player settings"
                                          Click="OnGearClick"
                                          Content="&#xE713;"
                                          Style="{DynamicResource RbPlayerIconToggleStyle}"
                                          ToolTip="Player settings"
                                          Visibility="{Binding HasControls, Converter={StaticResource Visible}}" />
                            <Button x:Name="FullScreen"
                                    AutomationProperties.Name="{Binding FullScreenName}"
                                    Command="{Binding FullScreenCommand}"
                                    Content="{Binding FullScreenGlyph}"
                                    Style="{DynamicResource RbPlayerIconButtonStyle}"
                                    ToolTip="{Binding FullScreenName}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
