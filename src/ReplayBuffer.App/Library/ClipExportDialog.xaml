<app:ShellWindow x:Class="ReplayBuffer.App.Library.ClipExportDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:app="clr-namespace:ReplayBuffer.App" xmlns:theme="clr-namespace:ReplayBuffer.App.Theme"
 Width="480" MaxHeight="720" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="{Binding ExportLabel}">
 <app:ShellWindow.Resources><BooleanToVisibilityConverter x:Key="Visible" /></app:ShellWindow.Resources>
 <DockPanel KeyboardNavigation.TabNavigation="Cycle">
  <Border DockPanel.Dock="Bottom" Padding="{DynamicResource RbDialogButtonBarPadding}" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" IsCancel="True" MinWidth="88" Click="Cancel" Margin="0,0,8,0" />
    <Button x:Name="SaveButton" Content="{Binding SaveLabel}" IsEnabled="{Binding CanSave}" IsDefault="True" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="Save" />
   </StackPanel>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{DynamicResource RbDialogContentPadding}">
   <TextBlock Text="{Binding ExportLabel}" FontSize="20" Margin="0,0,0,6" />
   <TextBlock Text="{Binding FormatSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
   <Label Content="Output name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
   <TextBox x:Name="NameBox" Text="{Binding ExportName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Export output name" />
   <TextBlock Text="Enter a file or folder name without path separators." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ValidExportName}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <DockPanel Margin="0,16,0,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="All" Command="{Binding AllTracksCommand}" Margin="0,0,6,0" /><Button Content="None" Command="{Binding NoTracksCommand}" /></StackPanel><TextBlock Text="Include audio tracks" VerticalAlignment="Center" /></DockPanel>
   <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Tracks}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" AutomationProperties.Name="{Binding Name}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <WrapPanel Margin="0,12,0,8" Visibility="{Binding MultipleTracks, Converter={StaticResource Visible}}"><RadioButton Content="{Binding SeparateLabel}" IsChecked="{Binding Separate}" GroupName="OutputMode" Margin="0,0,12,4" /><RadioButton Content="Combined mix" IsChecked="{Binding Mix}" GroupName="OutputMode" Margin="0,0,0,4" /></WrapPanel>
   <TextBlock Text="{Binding OutputSummary}" TextWrapping="Wrap" Margin="0,8,0,12" />
   <Separator />
   <TextBlock Text="{Binding DurationText}" Margin="0,8,0,4" />
   <TextBlock Text="{Binding EffectiveText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
  </StackPanel></ScrollViewer>
 </DockPanel>
</app:ShellWindow>
