<UserControl x:Class="ReplayBuffer.App.Library.ClipCreatorView" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ReplayBuffer.App.Library"
 xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /><theme:EmptyToCollapsedConverter x:Key="NotEmpty" /></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <local:ClipCreatorPanel Margin="0,0,8,0" ViewportHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
   <DockPanel Margin="0,0,0,4" LastChildFill="True">
    <Button Command="{Binding BackCommand}" Visibility="{Binding BackCommand, Converter={StaticResource NotEmpty}}" Style="{DynamicResource RbClipToolButtonStyle}" AutomationProperties.Name="Back to Library" ToolTip="Back to Library" DockPanel.Dock="Left" Margin="0,0,8,0"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 15,8 L 1,8 M 7,2 L 1,8 L 7,14" /></Button>
    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
     <Button x:Name="ExportButton" Click="Export" IsEnabled="{Binding CanOpenOptions}" Style="{DynamicResource RbClipJoinedButtonStyle}" AutomationProperties.Name="{Binding ExportLabel}"><StackPanel Orientation="Horizontal"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 8,1 L 8,11 M 4,7 L 8,11 L 12,7 M 2,11 L 2,15 L 14,15 L 14,11" Margin="0,0,7,0" /><TextBlock Text="{Binding ExportLabel}" FontWeight="Medium" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" /></StackPanel></Button>
     <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"><Button x:Name="ExportArrow" Padding="9" Style="{DynamicResource RbClipJoinedArrowButtonStyle}" Click="ChooseType" IsEnabled="{Binding CanOpenOptions}" AutomationProperties.Name="Choose export type" ToolTip="Choose export type" ><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,5 L 8,11 L 14,5" /></Button></Border>
    </StackPanel></Border>
    <StackPanel><TextBlock Text="Create clip" FontSize="20" /><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /></StackPanel>
   </DockPanel>
   <Grid>
    <local:PlayerView x:Name="Video" DataContext="{Binding Preview}">
     <local:PlayerView.Resources>
      <Style x:Key="RbPlayerIconButtonStyle" TargetType="Button">
       <Setter Property="Width" Value="34" /><Setter Property="Height" Value="32" /><Setter Property="Background" Value="Transparent" />
       <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
       <Setter Property="Template" Value="{DynamicResource RbClipPlaybackTemplate}" />
      </Style>
      <Style x:Key="RbPlayerIconToggleStyle" TargetType="ToggleButton">
       <Setter Property="Width" Value="34" /><Setter Property="Height" Value="32" /><Setter Property="Background" Value="Transparent" />
       <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
       <Setter Property="Template" Value="{DynamicResource RbClipPlaybackTemplate}" />
       <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger></Style.Triggers>
      </Style>
     </local:PlayerView.Resources>
    </local:PlayerView>
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="4,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" IsHitTestVisible="False"><TextBlock Text="{Binding PreviewLabel}" FontSize="11" /></Border>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="4,2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" IsHitTestVisible="False"><TextBlock Text="{Binding PlayheadText}" FontSize="11" AutomationProperties.Name="Source playhead" /></Border>
   </Grid>
   <WrapPanel x:Name="TimelineToolbar" Margin="0,4,0,0">

     <Button x:Name="PreviewButton" Style="{DynamicResource RbClipPreviewButtonStyle}" Content="Preview selection" Command="{Binding PreviewCommand}" Margin="0,0,8,4" />
     <Button Command="{Binding PanLeftCommand}" Style="{DynamicResource RbClipToolButtonStyle}" AutomationProperties.Name="Pan timeline left" ToolTip="Pan timeline left" Margin="0,0,0,4" ><Path Style="{DynamicResource RbClipIconStyle}" Data="M 15,8 L 1,8 M 7,2 L 1,8 L 7,14" /></Button>
     <Button Command="{Binding PanRightCommand}" Style="{DynamicResource RbClipToolButtonStyle}" AutomationProperties.Name="Pan timeline right" ToolTip="Pan timeline right" Margin="0,0,0,4" ><Path Style="{DynamicResource RbClipIconStyle}" Data="M 1,8 L 15,8 M 9,2 L 15,8 L 9,14" /></Button>
     <Button Command="{Binding ZoomOutCommand}" Style="{DynamicResource RbClipToolButtonStyle}" AutomationProperties.Name="Zoom timeline out" ToolTip="Zoom timeline out" Margin="8,0,0,4" ><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,8 L 14,8" /></Button>
     <Button Command="{Binding ZoomInCommand}" Style="{DynamicResource RbClipToolButtonStyle}" AutomationProperties.Name="Zoom timeline in" ToolTip="Zoom timeline in" Margin="0,0,0,4" ><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,8 L 14,8 M 8,2 L 8,14" /></Button>
   </WrapPanel>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <local:WaveformView x:Name="Timeline" Style="{DynamicResource RbClipWaveformStyle}" AutomationProperties.Name="Audio waveform and trim selection"
    ToolTip="Double-click the waveform to select the visible time range."
    AutomationProperties.HelpText="Double-click the waveform to select the visible time range. Drag the ruler playhead or click and drag the waveform to seek. P selects the playhead; Left and Right seek one millisecond. Home selects start trim handle; End selects end trim handle; Left and Right then trim one millisecond. Plus and minus zoom. Shift and mouse wheel pan. Up and Down scroll audio lanes." />
    <ScrollBar Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="{Binding ScrollMaximum, ElementName=Timeline}" Value="{Binding LaneOffset, ElementName=Timeline, Mode=TwoWay}" SmallChange="1" LargeChange="5" ViewportSize="5" AutomationProperties.Name="Scroll audio waveform lanes">
     <ScrollBar.Style><Style TargetType="ScrollBar"><Style.Triggers><DataTrigger Binding="{Binding ScrollMaximum, ElementName=Timeline}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollBar.Style>
    </ScrollBar>
   </Grid>
   <Border Margin="0,15,0,0" Padding="0,13,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
    <local:ClipRangePanel IsEnabled="{Binding CanEdit}">

      <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
       <Label Content="In" Target="{Binding ElementName=StartBox}" VerticalAlignment="Center" Padding="0,0,7,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
       <Border Style="{DynamicResource RbClipTimeGroupStyle}"><StackPanel Orientation="Horizontal">
        <TextBox x:Name="StartBox" Style="{DynamicResource RbClipTimeInputStyle}" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" KeyDown="CommitTime" AutomationProperties.Name="Selection start HH:MM:SS.mmm" />
        <Button Style="{DynamicResource RbClipToolButtonStyle}" Click="StartMinus" ToolTip="Start minus one millisecond" AutomationProperties.Name="Start minus one millisecond"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,8 L 14,8" /></Button>
        <Button Style="{DynamicResource RbClipToolButtonStyle}" Click="StartPlus" ToolTip="Start plus one millisecond" AutomationProperties.Name="Start plus one millisecond"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,8 L 14,8 M 8,2 L 8,14" /></Button>
       </StackPanel></Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
       <Label Content="Out" Target="{Binding ElementName=EndBox}" VerticalAlignment="Center" Padding="0,0,7,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
       <Border Style="{DynamicResource RbClipTimeGroupStyle}"><StackPanel Orientation="Horizontal">
        <TextBox x:Name="EndBox" Style="{DynamicResource RbClipTimeInputStyle}" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" KeyDown="CommitTime" AutomationProperties.Name="Selection end HH:MM:SS.mmm" />
        <Button Style="{DynamicResource RbClipToolButtonStyle}" Click="EndMinus" ToolTip="End minus one millisecond" AutomationProperties.Name="End minus one millisecond"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,8 L 14,8" /></Button>
        <Button Style="{DynamicResource RbClipToolButtonStyle}" Click="EndPlus" ToolTip="End plus one millisecond" AutomationProperties.Name="End plus one millisecond"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 2,8 L 14,8 M 8,2 L 8,14" /></Button>
       </StackPanel></Border>
      </StackPanel>

     <StackPanel HorizontalAlignment="Right" Margin="8,0,0,4"><TextBlock Text="{Binding SelectedDurationText}" FontWeight="Medium" Typography.NumeralAlignment="Tabular" /><TextBlock Text="selected" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></StackPanel>
    </local:ClipRangePanel>
   </Border>
   <TextBlock Text="{Binding EffectiveText}" TextWrapping="Wrap" Margin="0,2,0,2" />
   <WrapPanel Visibility="{Binding Exporting, Converter={StaticResource Visible}}" Margin="0,4"><Button Style="{DynamicResource RbClipButtonStyle}" Content="Cancel operation" Command="{Binding CancelCommand}" /></WrapPanel>
   <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,0,0,6" Visibility="{Binding Exporting, Converter={StaticResource Visible}}" />
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource NotEmpty}}" />
  </local:ClipCreatorPanel>
 </ScrollViewer>
</UserControl>
