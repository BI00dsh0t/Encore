<UserControl x:Class="ReplayBuffer.App.Library.LibraryView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Margin="0,0,0,12"
                    Padding="10,8"
                    Background="#FFF4E5"
                    BorderBrush="#E0A040"
                    BorderThickness="1"
                    Visibility="{Binding IsCleanupBlocked, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button Command="{Binding AcknowledgeCommand}"
                            Content="Acknowledge"
                            DockPanel.Dock="Right"
                            Margin="12,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center"
                               Text="The Library index couldn't be read, so it was rebuilt from the Output Folder. Cleanup is off until you acknowledge this."
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <TextBlock FontWeight="SemiBold" Text="Library" />
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}" />
                                <TextBlock Margin="0,2,0,0"
                                           Foreground="Gray"
                                           Text="{Binding Game}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Top"
                                       Text="{Binding Date}" />
                            <TextBlock Grid.Column="2"
                                       MinWidth="64"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Top"
                                       TextAlignment="Right">
                                <Run Text="{Binding Size, Mode=OneWay}" /><Run FontStyle="Italic" Text="{Binding Lock, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
