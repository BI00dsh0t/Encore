<UserControl x:Class="ReplayBuffer.App.Settings.TrackLayoutView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate x:Key="DeviceTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Margin="8,0,0,0" Style="{DynamicResource RbSettingsErrorTextStyle}" Text="{Binding Note}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <theme:SettingsContent Style="{DynamicResource RbSettingsContentStyle}">
            <CheckBox FontSize="{DynamicResource BodyTextBlockFontSize}"
                      Margin="0,0,0,12"
                      Content="Use Global Track Layout"
                      IsChecked="{Binding UsesGlobal}"
                      Visibility="{Binding IsProfile, Converter={StaticResource Visible}}" />
            <StackPanel IsEnabled="{Binding CanEdit}">
                <HeaderedContentControl Header="Devices" Style="{DynamicResource RbSettingsSectionStyle}">
                    <StackPanel>
                        <ListBox Height="110"
                                 ItemsSource="{Binding Devices}"
                                 SelectedItem="{Binding SelectedDevice}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource RbSettingsErrorTextStyle}"
                                                   Text="{Binding Note}" />
                                        <CheckBox FontSize="{DynamicResource BodyTextBlockFontSize}"
                                                  Margin="12,0,0,0"
                                                  Content="Mic"
                                                  IsChecked="{Binding IsMic}"
                                                  Visibility="{Binding CanBeMic, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding RemoveDeviceCommand}" Content="Remove" Margin="0,0,6,0" />
                        </StackPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Button Command="{Binding AddDeviceCommand}"
                                    Content="Add"
                                    DockPanel.Dock="Right"
                                    Margin="6,0,0,0" />
                            <ComboBox ItemTemplate="{StaticResource DeviceTemplate}"
                                      ItemsSource="{Binding Choices}"
                                      SelectedItem="{Binding SelectedChoice}" />
                        </DockPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Header="Tracks" Style="{DynamicResource RbSettingsSectionStyle}">
                    <StackPanel>
                        <ListBox Height="110"
                                 ItemsSource="{Binding Tracks}"
                                 SelectedItem="{Binding SelectedTrack}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar Width="80"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Maximum="1"
                                                     Minimum="0"
                                                     Style="{DynamicResource RbLevelMeterStyle}"
                                                     Value="{Binding Level, Mode=OneWay}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{DynamicResource RbSettingsCautionTextStyle}"
                                                   Text="&#x26A0;"
                                                   ToolTip="{Binding Warning}"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Command="{Binding AddTrackCommand}" Content="Add Track" Margin="0,0,6,0" />
                            <Button Command="{Binding MoveUpCommand}" Content="Up" Margin="0,0,6,0" />
                            <Button Command="{Binding MoveDownCommand}" Content="Down" Margin="0,0,6,0" />
                            <Button Command="{Binding DeleteTrackCommand}" Content="Delete" Margin="0,0,6,0" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" DataContext="{Binding SelectedTrack}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Name" />
                                <TextBox Grid.Column="1" Margin="0,4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox FontSize="{DynamicResource BodyTextBlockFontSize}"
                                      Margin="0,4"
                                      Content="Mic Mute affects this Track"
                                      IsChecked="{Binding MuteAffected}" />
                            <TextBlock Margin="0,4"
                                       Style="{DynamicResource RbSettingsCautionTextStyle}"
                                       Text="{Binding Warning}"
                                       Visibility="{Binding HasWarning, Converter={StaticResource Visible}}" />
                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource RbSettingsLabelStyle}" Text="Devices on this Track" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox FontSize="{DynamicResource BodyTextBlockFontSize}" Margin="0,2" IsChecked="{Binding IsChecked}">
                                            <ContentPresenter Content="{Binding Device}" ContentTemplate="{StaticResource DeviceTemplate}" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <Button Command="{Binding SaveCommand}"
                            Content="Save"
                            IsEnabled="{Binding IsDirty}"
                            Margin="0,0,6,0" />
                    <Button Command="{Binding RevertCommand}"
                            Content="Revert"
                            IsEnabled="{Binding IsDirty}"
                            Margin="0,0,6,0" />
                </StackPanel>
            </StackPanel>
        </theme:SettingsContent>
    </ScrollViewer>
</UserControl>
