<UserControl x:Class="ReplayBuffer.App.Settings.RecordingsSettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Recordings" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Monitor Recording captures" />
                <ComboBox Grid.Column="1"
                          Margin="0,3"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding Monitors}"
                          SelectedItem="{Binding SelectedMonitor}" />
                <Button Grid.Column="2"
                        Margin="6,3,0,3"
                        Padding="10,1"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh" />
            </Grid>
            <TextBlock Margin="0,6,0,0"
                       Foreground="Gray"
                       Text="Game Recordings are switched on per game on the Game Profiles page. The Record and Monitor Recording keys are on the Hotkeys page."
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
