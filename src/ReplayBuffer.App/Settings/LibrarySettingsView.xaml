<UserControl x:Class="ReplayBuffer.App.Settings.LibrarySettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:EmptyToCollapsedConverter x:Key="Collapsed" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <theme:SettingsContent Style="{DynamicResource RbSettingsContentStyle}">
            <HeaderedContentControl Header="Output Folder" Style="{DynamicResource RbSettingsSectionStyle}">
                <StackPanel>
                    <DockPanel>
                        <Button Margin="8,0,0,0"
                                Content="Use default"
                                Command="{Binding UseDefaultFolderCommand}"
                                DockPanel.Dock="Right"
                                Visibility="{Binding CanUseDefaultFolder, Converter={StaticResource Visible}}" />
                        <Button Margin="8,0,0,0" Click="Browse" Content="Browse…" DockPanel.Dock="Right" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{DynamicResource BodyTextBlockFontSize}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding OutputFolderText}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}" Text="{Binding FolderSizeText}" />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Cleanup" Style="{DynamicResource RbSettingsSectionStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox FontSize="{DynamicResource BodyTextBlockFontSize}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Content="Keep the folder under (GB)"
                                  IsChecked="{Binding SizeLimitEnabled}" />
                        <TextBox Grid.Column="1" Margin="0,4" Text="{Binding SizeLimitText}" />
                        <CheckBox Grid.Row="1"
                                  FontSize="{DynamicResource BodyTextBlockFontSize}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Content="Delete files older than (days)"
                                  IsChecked="{Binding AgeLimitEnabled}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding AgeLimitText}" />
                    </Grid>
                    <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}"
                               Text="Cleanup deletes the oldest files permanently, not to the Recycle Bin." />
                    <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}"
                               Text="Cleanup never deletes a Favourite or a file being written." />
                    <TextBlock Margin="0,8,0,0"
                               Style="{DynamicResource RbSettingsErrorTextStyle}"
                               Text="{Binding CleanupBlockedText}"
                               Visibility="{Binding CleanupBlockedText, Converter={StaticResource Collapsed}}" />
                </StackPanel>
            </HeaderedContentControl>
        </theme:SettingsContent>
    </ScrollViewer>
</UserControl>
