<UserControl x:Class="ReplayBuffer.App.Settings.HotkeysView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsKeyboardFocusWithinChanged="OnFocusWithinChanged"
             PreviewKeyDown="OnPreviewKeyDown"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="6,3,0,3" />
            <Setter Property="Padding" Value="10,1" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Hotkeys" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Text="Record mode" />
                <RadioButton Content="One toggle Hotkey" GroupName="RecordMode" IsChecked="{Binding IsToggleMode}" />
                <RadioButton Margin="12,0,0,0" Content="Separate start and stop" GroupName="RecordMode" IsChecked="{Binding IsSeparateMode}" />
            </StackPanel>
            <Grid Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="HotkeyLabel" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding BindingText}" />
                                <Button Grid.Column="2" Command="{Binding SetCommand}" Content="Set" />
                                <Button Grid.Column="3" Command="{Binding ClearCommand}" Content="Clear" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6" Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="DarkRed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
