<UserControl x:Class="ReplayBuffer.App.Settings.ReplayBufferSettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:ReplayBuffer.App.Settings"
             xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:EmptyToCollapsedConverter x:Key="Collapsed" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <theme:SettingsContent Style="{DynamicResource RbSettingsContentStyle}">
            <TextBlock Margin="0,0,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Intro}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsGlobal, Converter={StaticResource Visible}}" />

            <HeaderedContentControl Header="Clip length" Style="{DynamicResource RbSettingsSectionStyle}">
                <StackPanel>
                    <Grid IsEnabled="{Binding CanEditBufferWindow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Save the last" />
                        <TextBox Grid.Column="1" MinWidth="80" Margin="0,4" Text="{Binding BufferWindowText}" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="seconds" />
                    </Grid>
                    <Grid Visibility="{Binding IsGlobal, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Time between saves" />
                        <TextBox Grid.Column="1" MinWidth="80" Margin="0,4" Text="{Binding SaveCooldownText}" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="seconds" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Style="{DynamicResource RbSettingsHelpTextStyle}"
                                   Text="A press this soon after a save is ignored." />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Where recent gameplay is kept"
                                    Style="{DynamicResource RbSettingsSectionStyle}"
                                    Visibility="{Binding IsGlobal, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Keep it in" />
                        <RadioButton Grid.Column="1" Margin="0,4,16,4" Content="Memory" GroupName="Storage" IsChecked="{Binding IsMemory}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource RbSettingsStatusTextStyle}" Text="{Binding MemoryLine}" />
                        <RadioButton Grid.Row="1" Grid.Column="1" Margin="0,4,16,4" Content="Disk" GroupName="Storage" IsChecked="{Binding IsDisk}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource RbSettingsStatusTextStyle}" Text="{Binding DiskLine}" />
                        <TextBlock Grid.Row="2" Margin="0,12,12,0" VerticalAlignment="Top" Style="{DynamicResource RbSettingsLabelStyle}" Text="Cache folder" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <settings:FolderPickerView x:Name="CacheFolderPicker" DataContext="{Binding CacheFolder}" />
                            <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}" Text="{Binding CacheHelp}" />
                        </StackPanel>
                    </Grid>
                    <ContentControl Margin="0,8,0,0"
                                    Content="{Binding EstimateWarning}"
                                    Style="{DynamicResource RbInfoBarCautionStyle}"
                                    Visibility="{Binding EstimateWarning, Converter={StaticResource Collapsed}}" />
                    <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}"
                               Text="A game's own Clip length or Video quality changes this; see Games." />
                </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Video quality — for Clips and Recordings" Style="{DynamicResource RbSettingsSectionStyle}">
                <StackPanel>
                    <Grid IsEnabled="{Binding CanEditVideo}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Format" />
                        <ComboBox Grid.Column="1"
                                  Margin="0,4"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding Codecs}"
                                  SelectedItem="{Binding SelectedCodec}" />
                        <TextBlock Grid.Row="1" Style="{DynamicResource RbSettingsLabelStyle}" Text="Resolution" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,4"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding Resolutions}"
                                  SelectedItem="{Binding SelectedResolution}" />
                        <TextBlock Grid.Row="2" Style="{DynamicResource RbSettingsLabelStyle}" Text="Frame rate" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox MinWidth="80" Margin="0,4" Text="{Binding FpsText}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource RbSettingsStatusTextStyle}"
                                       Text="{Binding MaxFps, StringFormat='fps (up to {0})'}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Style="{DynamicResource RbSettingsLabelStyle}" Text="Bitrate" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                            <TextBox MinWidth="100" Margin="0,4" Text="{Binding BitrateText}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource RbSettingsStatusTextStyle}" Text="kbps" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Style="{DynamicResource RbSettingsHelpTextStyle}"
                                   Text="Higher looks better and makes bigger files." />
                        <CheckBox FontSize="{DynamicResource BodyTextBlockFontSize}" Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,8,0,4"
                                  Content="Variable bitrate (smaller files in quiet scenes)"
                                  IsChecked="{Binding IsVbr}" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>
        </theme:SettingsContent>
    </ScrollViewer>
</UserControl>
