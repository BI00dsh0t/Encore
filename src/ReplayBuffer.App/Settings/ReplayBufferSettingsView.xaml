<UserControl x:Class="ReplayBuffer.App.Settings.ReplayBufferSettingsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Replay Buffer" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Buffer Window (s)" />
                <TextBox Grid.Column="1" Text="{Binding BufferWindowText}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Keep the buffer in" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,3" Orientation="Horizontal">
                    <RadioButton Content="Memory" GroupName="Storage" IsChecked="{Binding IsMemory}" />
                    <RadioButton Margin="12,0,0,0" Content="Disk" GroupName="Storage" IsChecked="{Binding IsDisk}" />
                </StackPanel>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Ring folder (Disk)" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RingPath}" ToolTip="Empty uses the default folder." />
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Save cooldown (s)" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SaveCooldownText}" />
            </Grid>
            <TextBlock Margin="0,6,0,0" Text="{Binding EstimateText}" />
            <TextBlock Foreground="DarkRed" Text="{Binding EstimateWarning}" TextWrapping="Wrap" />

            <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Output" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Codec" />
                <ComboBox Grid.Column="1"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding Codecs}"
                          SelectedItem="{Binding SelectedCodec}" />
                <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Resolution" />
                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding Resolutions}"
                          SelectedItem="{Binding SelectedResolution}" />
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Frame rate (fps)" />
                <DockPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Right"
                               Foreground="Gray"
                               Text="{Binding MaxFps, StringFormat='up to {0}'}" />
                    <TextBox Text="{Binding FpsText}" />
                </DockPanel>
                <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Bitrate (kbps)" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BitrateText}" />
                <CheckBox Grid.Row="4"
                          Grid.Column="1"
                          Margin="0,3"
                          Content="Variable bitrate (VBR)"
                          IsChecked="{Binding IsVbr}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
