<UserControl x:Class="ReplayBuffer.App.Settings.GameVideoEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A game's own Video quality (story 10.10): the Clips page's rows, on a game-scoped Clips view model. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Format" />
        <ComboBox Grid.Column="1" Margin="0,4" DisplayMemberPath="Label" ItemsSource="{Binding Codecs}" SelectedItem="{Binding SelectedCodec}" />
        <TextBlock Grid.Row="1" Style="{DynamicResource RbSettingsLabelStyle}" Text="Resolution" />
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" DisplayMemberPath="Label" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />
        <TextBlock Grid.Row="2" Style="{DynamicResource RbSettingsLabelStyle}" Text="Frame rate" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBox MinWidth="80" Margin="0,4" Text="{Binding FpsText}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource RbSettingsStatusTextStyle}" Text="{Binding MaxFps, StringFormat='fps (up to {0})'}" />
        </StackPanel>
        <TextBlock Grid.Row="3" Style="{DynamicResource RbSettingsLabelStyle}" Text="Bitrate" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <TextBox MinWidth="100" Margin="0,4" Text="{Binding BitrateText}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{DynamicResource RbSettingsStatusTextStyle}" Text="kbps" />
        </StackPanel>
        <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,8,0,4" FontSize="{DynamicResource BodyTextBlockFontSize}" Content="Variable bitrate (smaller files in quiet scenes)" IsChecked="{Binding IsVbr}" />
    </Grid>
</UserControl>
