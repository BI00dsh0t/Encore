<UserControl x:Class="ReplayBuffer.App.Settings.GameProfilesView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <theme:SettingsContent Style="{DynamicResource RbSettingsContentStyle}">
            <HeaderedContentControl Header="Games" Style="{DynamicResource RbSettingsSectionStyle}">
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox Text="{Binding Name}" />
                                    <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}"
                                               Text="{Binding ProfileId}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding ProfileId}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          FontSize="{DynamicResource BodyTextBlockFontSize}"
                                          Margin="12,4,0,0"
                                          VerticalAlignment="Top"
                                          Content="Ignored"
                                          IsChecked="{Binding Ignored}" />
                                <CheckBox Grid.Column="2"
                                          FontSize="{DynamicResource BodyTextBlockFontSize}"
                                          Margin="12,4,0,0"
                                          VerticalAlignment="Top"
                                          Content="Recordings"
                                          IsChecked="{Binding RecordingsEnabled}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Add a game by hand" Style="{DynamicResource RbSettingsSectionStyle}">
                <DockPanel>
                    <Button Command="{Binding AddCommand}"
                            Content="Add"
                            DockPanel.Dock="Right"
                            Margin="6,0,0,0" />
                    <Button Click="Browse"
                            Content="Browse..."
                            DockPanel.Dock="Right"
                            Margin="6,0,0,0" />
                    <TextBox Text="{Binding AddPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Overrides for" Style="{DynamicResource RbSettingsSectionStyle}">
                <StackPanel>
                    <ComboBox DisplayMemberPath="Name"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}" />
                    <TextBlock Style="{DynamicResource RbSettingsHelpTextStyle}"
                               Text="Changes to a game's settings apply at the next Reset of its Replay Buffer."
                               Visibility="{Binding HasSelectedProfile, Converter={StaticResource Visible}}" />
                </StackPanel>
            </HeaderedContentControl>

            <!-- The embedded views carry their own section cards, so they follow the Overrides card, not inside it. -->
            <StackPanel Visibility="{Binding HasSelectedProfile, Converter={StaticResource Visible}}">
                <ContentControl Content="{Binding OverrideOutput.View}" />
                <ContentControl Margin="0,0,0,8" Content="Track Layout" Style="{DynamicResource RbSectionHeaderStyle}" />
                <ContentControl Content="{Binding OverrideTrackLayout.View}" />
            </StackPanel>
        </theme:SettingsContent>
    </ScrollViewer>
</UserControl>
