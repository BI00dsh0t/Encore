<!--
    The settings pages' shared layout (story 5; EXPERIENCE.md Settings section, Settings row, Page error
    message): the content column, a section (header above a card), the label column, help and status
    text, and the page error info bar. Theme-neutral: every colour, corner and type comes from a token or
    theme key through DynamicResource, so the same dictionary serves both themes. ThemeService places it.
-->
<ResourceDictionary x:Class="ReplayBuffer.App.Theme.SettingsLayout"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The page content: at most 720 wide, left-aligned, one label column for every row on the page. -->
    <Style x:Key="RbSettingsContentStyle" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="720" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    </Style>

    <!-- A section: its header, 8 below it the card holding the rows, and spacing.xl to the next section. -->
    <Style x:Key="RbSettingsSectionStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <ContentControl Margin="0,0,0,8" Content="{TemplateBinding Header}" Style="{DynamicResource RbSectionHeaderStyle}" />
                        <Border Style="{DynamicResource RbCardStyle}">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row's label, in the shared label column. -->
    <Style x:Key="RbSettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Help text under its row: caption, muted. -->
    <Style x:Key="RbSettingsHelpTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="{DynamicResource CaptionTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Inline status beside or under a control, and its danger form. -->
    <Style x:Key="RbSettingsStatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RbSettingsErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The page's refused-update or validation message: a danger info bar, shown only while it has text. -->
    <Style x:Key="RbSettingsPageMessageStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MaxWidth" Value="720" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ContentControl Content="{TemplateBinding Content}" Style="{DynamicResource RbInfoBarDangerStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
