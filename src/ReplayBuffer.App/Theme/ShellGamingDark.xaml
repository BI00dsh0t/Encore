<!--
    The shell's styles under Gaming dark (story 3; DESIGN.md Nav item, Status header, Elevation): the same
    keys as ShellFluent.xaml. Nav items are full-width and square with a 3 px accent bar, and nav items,
    the section label and the state line are uppercase through the converter, so the wording and
    automation names stay sentence case. Every colour, corner and type comes from a token key.
-->
<ResourceDictionary x:Class="ReplayBuffer.App.Theme.ShellGamingDark"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:ReplayBuffer.App.Theme">

    <theme:UppercaseConverter x:Key="RbShellUppercase" />

    <!-- Nav items run the pane's full width, flush with its edge. -->
    <Thickness x:Key="RbNavPanePadding">0,0,0,8</Thickness>
    <Thickness x:Key="RbNavBrandMargin">16,16,16,24</Thickness>

    <!-- No layer edge: the nav pane and the content share bg-base. -->
    <Style x:Key="RbShellContentLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    </Style>

    <!-- The status header's state line: body-strong, uppercase. -->
    <Style x:Key="RbStatusStateStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RbShellUppercase}}" TextWrapping="Wrap" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Settings section label: caption, uppercase, text-disabled, so it never reads as a nav item. -->
    <ControlTemplate x:Key="RbNavSectionTemplate" TargetType="ListBoxItem">
        <TextBlock Margin="16,16,16,4"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorDisabledBrush}"
                   Text="{Binding Title, Converter={StaticResource RbShellUppercase}}" />
    </ControlTemplate>

    <!-- Nav item: text-secondary, uppercase; selected is accent-subtle with a full-height accent bar. -->
    <Style x:Key="RbNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="theme:NavPress.Track" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RbNavItemCornerRadius}" />
                        <Border x:Name="Pill"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                        <TextBlock x:Name="Label"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Text="{Binding Title, Converter={StaticResource RbShellUppercase}}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource RbAccentSubtleBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="theme:NavPress.IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSection}" Value="True">
                <Setter Property="Template" Value="{StaticResource RbNavSectionTemplate}" />
                <Setter Property="Height" Value="NaN" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
            <!-- Below 640 px the pane narrows and long titles trim, so the title shows as a tooltip. -->
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Narrow">
                <Setter Property="ToolTip" Value="{Binding Title}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
