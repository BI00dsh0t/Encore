<!--
    The Library's look (story 4; DESIGN.md Library row, Group header, Star toggle, filters, banner, empty
    state), the same dictionary in both themes: every colour, corner and type comes from a token key that
    both themes define, and Gaming's uppercase comes from RbSectionHeaderStyle and its ToggleButton template.
-->
<ResourceDictionary x:Class="ReplayBuffer.App.Theme.LibraryTheme"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Library row: a card that takes fill-control-hover on hover, and keeps it while its context menu is open. -->
    <Style x:Key="RbLibraryRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Group header: the section header in text-secondary, then a divider rule filling the row. -->
    <Style x:Key="RbLibraryGroupHeaderStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,12,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Style="{DynamicResource RbSectionHeaderStyle}" />
                        <Border Grid.Column="1"
                                Height="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumbnail: 128 × 72 in the small corner; the placeholder is fill-control with a ▶ in text-secondary. -->
    <Style x:Key="RbLibraryThumbnailStyle" TargetType="Border">
        <Setter Property="Width" Value="128" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
    </Style>
    <Style x:Key="RbLibraryThumbnailImageStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
    </Style>
    <Style x:Key="RbLibraryPlaceholderGlyphStyle" TargetType="Path">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="M 0,0 L 14,8 L 0,16 Z" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Length badge: bottom-right on the thumbnail; hidden while the length is unknown (or the file is being written). -->
    <Style x:Key="RbLibraryLengthBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlOnImageFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Length}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RbLibraryLengthTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Lock pill: "Saving…" while the file is being written. -->
    <Style x:Key="RbLibraryLockPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="RbLibraryLockTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <!-- The row's text: the name in body-strong, then "game · date · size" in caption. -->
    <Style x:Key="RbLibraryNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RbLibraryMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Filters: the combos' captions. -->
    <Style x:Key="RbLibraryFilterCaptionStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- The last row action's failure, under the filters. -->
    <Style x:Key="RbLibraryActionErrorStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
