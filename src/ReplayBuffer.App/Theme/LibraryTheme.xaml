<!--
    The Library's look (story 4; DESIGN.md Library row, Group header, Star toggle, filters, banner, empty
    state), the same dictionary in both themes: every colour, corner and type comes from a token key that
    both themes define, and Gaming's uppercase comes from RbSectionHeaderStyle and its ToggleButton template.
    Story 10.2 adds the selected row, the focus ring, the list and its containers, and the command bar.
-->
<ResourceDictionary x:Class="ReplayBuffer.App.Theme.LibraryTheme"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Library row: a card that takes fill-control-hover on hover. Selected (story 10.2; DESIGN.md addendum
        Library row, selected), it takes RbLibraryRowSelectedBrush, hovered or not, with the accent bar.
    -->
    <Style x:Key="RbLibraryRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RbLibraryRowSelectedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The selected row's 3 px accent bar on the card's left edge, as the nav item's; square under Gaming dark. -->
    <Style x:Key="RbLibrarySelectionBarStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="-7,8,0,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbNavItemCornerRadius}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The focused row's ring: focus-outer around the card (its margin matches the card's), shown while the
        row is the page's focused one and keyboard focus is in the list; selected or not, so the two differ.
    -->
    <Style x:Key="RbLibraryFocusRingStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFocused}" Value="True" />
                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The list: transparent, borderless, one virtualized panel (recycling, pixel scroll) in its own scroll
        viewer. The background takes clicks on the empty space below the rows.
    -->
    <Style x:Key="RbLibraryListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTextSearchEnabled" Value="False" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer CanContentScroll="True"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The list's containers: only the content, no selection look of their own (the row card draws it from the
        page's selection). A group header's container can't take focus.
    -->
    <Style x:Key="RbLibraryItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="{Binding IsRow}" />
        <Setter Property="IsTabStop" Value="{Binding IsRow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Command bar (DESIGN.md addendum Library command bar): a one-line card, 40 px tall in both states. -->
    <Style x:Key="RbLibraryCommandBarStyle" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12,0,4,0" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!-- The ✕: a subtle (transparent) button, fill-subtle on hover. -->
    <Style x:Key="RbLibraryClearSelectionButtonStyle" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The bar's texts: the count in body-strong, the summary in body, captions in text-secondary. -->
    <Style x:Key="RbLibraryBarTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RbLibraryBarCountStyle" TargetType="TextBlock" BasedOn="{StaticResource RbLibraryBarTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="RbLibraryBarCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource RbLibraryBarTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Group header: the section header in text-secondary, then a divider rule filling the row. -->
    <Style x:Key="RbLibraryGroupHeaderStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,12,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Style="{DynamicResource RbSectionHeaderStyle}" />
                        <Border Grid.Column="1"
                                Height="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumbnail: 128 × 72 in the small corner; the placeholder is fill-control with a ▶ in text-secondary. -->
    <Style x:Key="RbLibraryThumbnailStyle" TargetType="Border">
        <Setter Property="Width" Value="128" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
    </Style>
    <Style x:Key="RbLibraryThumbnailImageStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
    </Style>
    <Style x:Key="RbLibraryPlaceholderGlyphStyle" TargetType="Path">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Data" Value="M 0,0 L 14,8 L 0,16 Z" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Length badge: bottom-right on the thumbnail; hidden while the length is unknown (or the file is being written). -->
    <Style x:Key="RbLibraryLengthBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlOnImageFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Length}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RbLibraryLengthTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Lock pill: "Saving…" while the file is being written. -->
    <Style x:Key="RbLibraryLockPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RbSmallCornerRadius}" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="RbLibraryLockTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>

    <!-- The row's text: the name in body-strong, then "game · date · size" in caption. -->
    <Style x:Key="RbLibraryNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RbLibraryMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Filters: the combos' captions. -->
    <Style x:Key="RbLibraryFilterCaptionStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- The last row action's failure, under the filters. -->
    <Style x:Key="RbLibraryActionErrorStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
