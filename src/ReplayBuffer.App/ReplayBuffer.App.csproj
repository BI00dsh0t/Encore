<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>
  <!--
    WPF's Fluent theme puts Mica behind every window unless this switch is on, and caches the switch the
    first time any window shows, so it is set in the runtimeconfig, from process start (AD-23; ThemeService).
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReplayBuffer.App.Tests" />
  </ItemGroup>
  <!--
    Core's canvas rule, shared with the Hotkeys screen picker (AD-25, story 11.4). It's a pure function on
    Contracts types, compiled here as a linked source file, because AD-2's graph has no App to Core edge.
  -->
  <ItemGroup>
    <Compile Include="..\ReplayBuffer.Core\Monitors\MonitorCanvasRule.cs" Link="Settings\MonitorCanvasRule.cs" />
    <Compile Include="..\Shared\ClipPeakFile.cs" Link="Library\ClipPeakFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReplayBuffer.Contracts\ReplayBuffer.Contracts.csproj" />
    <ProjectReference Include="..\ReplayBuffer.Platform.Desktop\ReplayBuffer.Platform.Desktop.csproj" />
    <!-- Build order only: the App never compiles against the engine (AD-2). -->
    <ProjectReference Include="..\ReplayBuffer.Engine\ReplayBuffer.Engine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The App launches the engine from its own folder, so a dev build gets the engine beside it, as the install folder has it. -->
  <Target Name="CopyEngineBesideApp" AfterTargets="Build">
    <MSBuild Projects="..\ReplayBuffer.Engine\ReplayBuffer.Engine.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_EngineTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_EngineFile Include="%(_EngineTargetPath.RootDir)%(_EngineTargetPath.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_EngineFile)"
          DestinationFiles="@(_EngineFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_EngineFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
