<UserControl x:Class="ReplayBuffer.App.DrillInHeader"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Breadcrumb">
    <!-- Story 10.10's breadcrumb header (DESIGN.md addendum): Back, the parent's title as a link, ›, the item's name. -->
    <StackPanel Orientation="Horizontal">
        <Button x:Name="BackButton"
                Margin="0,0,12,0"
                Padding="8,4"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding BackName}"
                Command="{Binding BackCommand}"
                ToolTip="Back (Esc)">
            <TextBlock FontFamily="{DynamicResource RbGamesGlyphFont}" FontSize="16" Text="&#xE72B;" />
        </Button>
        <TextBlock VerticalAlignment="Center" FontSize="20">
            <Hyperlink Command="{Binding BackCommand}" Style="{DynamicResource RbGamesLinkStyle}">
                <Run Text="{Binding ParentTitle, Mode=OneWay}" />
            </Hyperlink>
        </TextBlock>
        <TextBlock Margin="12,0" VerticalAlignment="Center" Style="{DynamicResource RbGamesChevronStyle}" />
        <ContentControl VerticalAlignment="Center" Content="{Binding ItemTitle}" Style="{DynamicResource RbPageTitleStyle}" />
    </StackPanel>
</UserControl>
