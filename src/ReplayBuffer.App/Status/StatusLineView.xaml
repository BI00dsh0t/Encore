<UserControl x:Class="ReplayBuffer.App.Status.StatusLineView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock FontWeight="SemiBold"
                   Text="{Binding State}"
                   TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="Gray"
                                       Text="{Binding Time}" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding Severity}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Padding="8,0"
                                    Command="{Binding DismissCommand}"
                                    Content="Dismiss"
                                    Visibility="{Binding CanDismiss, Converter={StaticResource Visible}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
