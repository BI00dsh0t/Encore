<!-- The Main App's shell: the nav pane, then the status header, the page header and the page. Every colour is a token. -->
<app:ShellWindow x:Class="Encore.App.MainWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:app="clr-namespace:Encore.App"
                 xmlns:theme="clr-namespace:Encore.App.Theme"
                 x:Name="Shell"
                 Title="Encore"
                 Width="960"
                 Height="600"
                 MinWidth="480"
                 MinHeight="320"
                 KeyDown="OnKeyDown"
                 SizeChanged="OnSizeChanged"
                 WindowStartupLocation="CenterScreen"
                 MouseUp="OnMouseUp">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="EncoreShellVisible" />
            <theme:TrueToCollapsedConverter x:Key="EncoreShellHidden" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NavLayer" Style="{DynamicResource EncoreShellNavLayerStyle}" />
        <DockPanel x:Name="NavPane" Margin="{DynamicResource EncoreNavPanePadding}">
            <ToggleButton x:Name="NavigationToggle" DockPanel.Dock="Top" Height="36" Margin="4,8,4,0"
                          IsChecked="{Binding IsNavigationExpanded, Mode=TwoWay}"
                          Style="{DynamicResource EncoreSettingsNavStyle}" HorizontalAlignment="Left" Width="40"
                          ToolTip="{Binding NavigationToggleLabel}" AutomationProperties.Name="{Binding NavigationToggleLabel}"><Path Width="16" Height="16" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" Data="M 1,1 L 15,1 L 15,15 L 1,15 Z M 6,1 L 6,15" /></ToggleButton>
            <ToggleButton x:Name="SettingsButton" DockPanel.Dock="Bottom" Style="{DynamicResource EncoreSettingsNavStyle}"
                          IsChecked="{Binding IsSettingsTabSelected, Mode=OneWay}" Click="OnSettingsClick"
                          ToolTip="Settings" AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                 <TextBlock Text="Settings" Margin="12,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsNavigationExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </ToggleButton>
            <ContentControl x:Name="Brand"
                            Margin="{DynamicResource EncoreNavBrandMargin}"
                            Content="{Binding Title, ElementName=Shell}"
                            DockPanel.Dock="Top"
                            Style="{DynamicResource EncoreBrandStyle}"
                            Visibility="{Binding IsNavigationExpanded, Converter={StaticResource EncoreShellVisible}}" />
            <app:NavListBox x:Name="Nav"
                     Padding="0"
                     AutomationProperties.Name="Navigation"
                     Background="{DynamicResource SubtleFillColorTransparentBrush}"
                     BorderThickness="0"
                     FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{DynamicResource EncoreNavItemStyle}"
                     ItemsSource="{Binding PrimaryNavItems, Mode=OneTime}"
                     KeyDown="OnNavKeyDown"
                     PreviewMouseLeftButtonUp="OnNavClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                     SelectionMode="Single"
                     TextSearch.TextPath="Title" />
        </DockPanel>

        <Border x:Name="ContentLayer" Grid.Column="1" Style="{DynamicResource EncoreShellContentLayerStyle}">
            <DockPanel x:Name="ContentPanel" Margin="{DynamicResource EncorePagePadding}">
                <ContentControl x:Name="StatusHeader"
                                Content="{Binding StatusLine.View}"
                                Visibility="{Binding StatusLine.HasErrors, Converter={StaticResource EncoreShellVisible}}"
                                DockPanel.Dock="Top"
                                Focusable="False" />
                <ComboBox x:Name="SettingsSections" DockPanel.Dock="Top" Margin="0,12,0,0"
                          ItemsSource="{Binding SettingsNavItems, Mode=OneTime}"
                          PreviewMouseLeftButtonUp="OnSettingsSectionClick" PreviewKeyDown="OnSettingsSectionKeyDown"
                          SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}" AutomationProperties.Name="Settings section"
                          Visibility="{Binding IsSettingsTabSelected, Converter={StaticResource EncoreShellVisible}}">
                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" /><Border Width="6" Height="6" Margin="8,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource EncoreShellVisible}}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Grid x:Name="PageHeader" Margin="0,16,0,0" DockPanel.Dock="Top">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsCreatingClip}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <ContentControl x:Name="PageTitle"
                                    Content="{Binding CurrentTitle}"
                                    Style="{DynamicResource EncorePageTitleStyle}"
                                    Visibility="{Binding IsDrilledIn, Converter={StaticResource EncoreShellHidden}}" />
                    <app:DrillInHeader x:Name="Breadcrumb"
                                       DataContext="{Binding CurrentDrillIn}"
                                       Visibility="{Binding DataContext.IsDrilledIn, ElementName=Shell, Converter={StaticResource EncoreShellVisible}}" />
                </Grid>
                <!-- The wrapper hides the bar off the settings pages; the bar's own style hides it while empty. -->
                <Border DockPanel.Dock="Bottom">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettingsTabSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl x:Name="PageMessage"
                                    Margin="0,12,0,0"
                                    Content="{Binding SelectedPage.Message}"
                                    Style="{DynamicResource EncoreSettingsPageMessageStyle}" />
                </Border>
                <ContentControl x:Name="Page"
                                Margin="0,12,0,0"
                                Content="{Binding CurrentView}"
                                Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</app:ShellWindow>
