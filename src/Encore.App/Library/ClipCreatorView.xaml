<!-- The clip creator: the preview, the transport, the waveform timeline with its trim range, and Export. -->
<UserControl x:Class="Encore.App.Library.ClipCreatorView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Encore.App.Library"
             xmlns:theme="clr-namespace:Encore.App.Theme">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:EmptyToCollapsedConverter x:Key="NotEmpty" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <local:ClipCreatorPanel Margin="0,0,8,0"
                                ViewportHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
                <Button Command="{Binding BackCommand}"
                        Visibility="{Binding BackCommand, Converter={StaticResource NotEmpty}}"
                        Style="{DynamicResource EncoreClipToolButtonStyle}"
                        AutomationProperties.Name="Back to Library"
                        ToolTip="Back to Library"
                        DockPanel.Dock="Left"
                        Margin="0,0,8,0">
                    <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 15,8 L 1,8 M 7,2 L 1,8 L 7,14" />
                </Button>
                <Border DockPanel.Dock="Right"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ExportButton"
                                Click="Export"
                                IsEnabled="{Binding CanOpenOptions}"
                                Style="{DynamicResource EncoreClipJoinedButtonStyle}"
                                AutomationProperties.Name="{Binding ExportLabel}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource EncoreClipIconStyle}"
                                      Data="M 8,1 L 8,11 M 4,7 L 8,11 L 12,7 M 2,11 L 2,15 L 14,15 L 14,11"
                                      Margin="0,0,7,0" />
                                <TextBlock Text="{Binding ExportLabel}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <Button x:Name="ExportArrow"
                                    Padding="9"
                                    Style="{DynamicResource EncoreClipJoinedArrowButtonStyle}"
                                    Click="ChooseType"
                                    IsEnabled="{Binding CanOpenOptions}"
                                    AutomationProperties.Name="Choose export type"
                                    ToolTip="Choose export type">
                                <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,5 L 8,11 L 14,5" />
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="Create clip" FontSize="20" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                </StackPanel>
            </DockPanel>
            <Grid>
                <local:PlayerView x:Name="Video" DataContext="{Binding Preview}" IsClipEditor="True">
                    <local:PlayerView.Resources>
                        <Style x:Key="EncorePlayerIconButtonStyle" TargetType="Button">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                            <Setter Property="Template" Value="{DynamicResource EncoreClipPlaybackTemplate}" />
                        </Style>
                        <Style x:Key="EncorePlayerIconToggleStyle" TargetType="ToggleButton">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                            <Setter Property="Template" Value="{DynamicResource EncoreClipPlaybackTemplate}" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </local:PlayerView.Resources>
                </local:PlayerView>
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8"
                        Padding="4,2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding PreviewLabel}" FontSize="11" />
                </Border>
            </Grid>
            <Border x:Name="EditorCard"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,14,0,0"
                    Padding="14,0">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                        <local:ClipTransportPanel>
                            <TextBlock Text="{Binding PlaybackText}"
                                       FontSize="12"
                                       Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.Name="Source elapsed and total time" />
                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEdit}">
                                <Button x:Name="SkipBack"
                                        Command="{Binding SkipBackCommand}"
                                        Style="{DynamicResource EncoreClipSkipButtonStyle}"
                                        ToolTip="Back 10 seconds"
                                        AutomationProperties.Name="Seek back ten seconds">
                                    <Grid>
                                        <Path Style="{DynamicResource EncoreClipIconStyle}"
                                              Data="M 5,4 L 1,4 L 1,0 M 1,4 A 7,7 0 1 1 0,11" />
                                        <TextBlock Text="10"
                                                   FontSize="8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    </Grid>
                                </Button>
                                <Button x:Name="TransportPlay"
                                        Command="{Binding Preview.PlayPauseCommand}"
                                        Content="{Binding Preview.PlayPauseGlyph}"
                                        Style="{DynamicResource EncoreClipTransportPlayStyle}"
                                        ToolTip="{Binding Preview.PlayPauseLabel}"
                                        AutomationProperties.Name="{Binding Preview.PlayPauseLabel}"
                                        Margin="6,0" />
                                <Button x:Name="SkipForward"
                                        Command="{Binding SkipForwardCommand}"
                                        Style="{DynamicResource EncoreClipSkipButtonStyle}"
                                        ToolTip="Forward 10 seconds"
                                        AutomationProperties.Name="Seek forward ten seconds">
                                    <Grid>
                                        <Path Style="{DynamicResource EncoreClipIconStyle}"
                                              Data="M 11,4 L 15,4 L 15,0 M 15,4 A 7,7 0 1 0 16,11" />
                                        <TextBlock Text="10"
                                                   FontSize="8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <Button x:Name="PreviewButton"
                                    Style="{DynamicResource EncoreClipPreviewButtonStyle}"
                                    Command="{Binding PreviewCommand}"
                                    FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{DynamicResource EncoreClipIconStyle}"
                                          Data="M 5,5 L 14,14 M 5,11 L 14,2 M 5,4 A 2,2 0 1 1 1,4 A 2,2 0 1 1 5,4 M 5,12
                                                A 2,2 0 1 1 1,12 A 2,2 0 1 1 5,12"
                                          Margin="0,0,7,0" />
                                    <TextBlock Text="Preview selection" />
                                </StackPanel>
                            </Button>
                        </local:ClipTransportPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:WaveformView x:Name="Timeline"
                                            Style="{DynamicResource EncoreClipWaveformStyle}"
                                            AutomationProperties.Name="Audio waveform and trim selection"
                                            ToolTip="{Binding ThumbnailHint}"
                                            AutomationProperties.HelpText="Drag the selected area to move In and Out together. Click to seek; drag the ruler playhead or outside the selection to scrub. Drag the edge grips to trim. Double-click the waveform to select the visible time range. P selects the playhead; Left and Right seek one millisecond. Home selects start trim handle; End selects end trim handle; Left and Right then trim one millisecond. Plus and minus zoom. Shift and mouse wheel pan. Up and Down scroll audio lanes." />
                        <ScrollBar Grid.Column="1"
                                   Orientation="Vertical"
                                   Minimum="0"
                                   Maximum="{Binding ScrollMaximum, ElementName=Timeline}"
                                   Value="{Binding LaneOffset, ElementName=Timeline, Mode=TwoWay}"
                                   SmallChange="1"
                                   LargeChange="5"
                                   ViewportSize="5"
                                   AutomationProperties.Name="Scroll audio waveform lanes">
                            <ScrollBar.Style>
                                <Style TargetType="ScrollBar">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScrollMaximum, ElementName=Timeline}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollBar.Style>
                        </ScrollBar>
                    </Grid>
                    <DockPanel Margin="0,4" LastChildFill="True">
                        <WrapPanel x:Name="TimelineToolbar" DockPanel.Dock="Right">
                            <Button Command="{Binding PanLeftCommand}"
                                    Style="{DynamicResource EncoreClipToolButtonStyle}"
                                    AutomationProperties.Name="Pan timeline left"
                                    ToolTip="Pan timeline left">
                                <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 15,8 L 1,8 M 7,2 L 1,8 L 7,14" />
                            </Button>
                            <Button Command="{Binding PanRightCommand}"
                                    Style="{DynamicResource EncoreClipToolButtonStyle}"
                                    AutomationProperties.Name="Pan timeline right"
                                    ToolTip="Pan timeline right">
                                <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 1,8 L 15,8 M 9,2 L 15,8 L 9,14" />
                            </Button>
                            <Border BorderThickness="1,0,0,0"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    Margin="6,8" />
                            <Button Command="{Binding ZoomOutCommand}"
                                    Style="{DynamicResource EncoreClipToolButtonStyle}"
                                    AutomationProperties.Name="Zoom timeline out"
                                    ToolTip="Zoom timeline out">
                                <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,8 L 14,8" />
                            </Button>
                            <TextBlock Text="{Binding ZoomText}" FontSize="11" VerticalAlignment="Center" Margin="2,0" />
                            <Button Command="{Binding ZoomInCommand}"
                                    Style="{DynamicResource EncoreClipToolButtonStyle}"
                                    AutomationProperties.Name="Zoom timeline in"
                                    ToolTip="Zoom timeline in">
                                <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,8 L 14,8 M 8,2 L 8,14" />
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding ViewportText}"
                                   ToolTip="{Binding ViewportText}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>
                    <Border Margin="0"
                            Padding="0,12,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <local:ClipRangePanel IsEnabled="{Binding CanEdit}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <Label Content="In"
                                       Target="{Binding ElementName=StartBox}"
                                       VerticalAlignment="Center"
                                       Padding="0,0,7,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border Style="{DynamicResource EncoreClipTimeGroupStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="StartBox"
                                                 Style="{DynamicResource EncoreClipTimeInputStyle}"
                                                 Text="{Binding StartText, UpdateSourceTrigger=LostFocus}"
                                                 KeyDown="CommitTime"
                                                 AutomationProperties.Name="Selection start HH:MM:SS.mmm" />
                                        <Button Style="{DynamicResource EncoreClipToolButtonStyle}"
                                                Click="StartMinus"
                                                ToolTip="Start minus one millisecond"
                                                AutomationProperties.Name="Start minus one millisecond">
                                            <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,8 L 14,8" />
                                        </Button>
                                        <Button Style="{DynamicResource EncoreClipToolButtonStyle}"
                                                Click="StartPlus"
                                                ToolTip="Start plus one millisecond"
                                                AutomationProperties.Name="Start plus one millisecond">
                                            <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,8 L 14,8 M 8,2 L 8,14" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <Label Content="Out"
                                       Target="{Binding ElementName=EndBox}"
                                       VerticalAlignment="Center"
                                       Padding="0,0,7,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Border Style="{DynamicResource EncoreClipTimeGroupStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="EndBox"
                                                 Style="{DynamicResource EncoreClipTimeInputStyle}"
                                                 Text="{Binding EndText, UpdateSourceTrigger=LostFocus}"
                                                 KeyDown="CommitTime"
                                                 AutomationProperties.Name="Selection end HH:MM:SS.mmm" />
                                        <Button Style="{DynamicResource EncoreClipToolButtonStyle}"
                                                Click="EndMinus"
                                                ToolTip="End minus one millisecond"
                                                AutomationProperties.Name="End minus one millisecond">
                                            <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,8 L 14,8" />
                                        </Button>
                                        <Button Style="{DynamicResource EncoreClipToolButtonStyle}"
                                                Click="EndPlus"
                                                ToolTip="End plus one millisecond"
                                                AutomationProperties.Name="End plus one millisecond">
                                            <Path Style="{DynamicResource EncoreClipIconStyle}" Data="M 2,8 L 14,8 M 8,2 L 8,14" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Margin="8,0,0,4">
                                <TextBlock Text="{Binding SelectionLengthText}"
                                           FontWeight="Medium"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="selected"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </local:ClipRangePanel>
                    </Border>
                    <TextBlock Text="{Binding EffectiveText}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,12" />
                </StackPanel>
            </Border>
            <DockPanel Margin="0,6,0,0">
                <Button Content="Keyboard shortcuts"
                        DockPanel.Dock="Right"
                        Click="KeyboardHelp"
                        Style="{DynamicResource EncoreClipButtonStyle}"
                        FontSize="11"
                        Padding="0" />
                <TextBlock Text="Double-click a waveform to select the visible range."
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel Visibility="{Binding Exporting, Converter={StaticResource Visible}}" Margin="0,4">
                <Button Style="{DynamicResource EncoreClipButtonStyle}"
                        Content="Cancel operation"
                        Command="{Binding CancelCommand}" />
            </WrapPanel>
            <ProgressBar Minimum="0"
                         Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}"
                         Height="5"
                         Margin="0,0,0,6"
                         Visibility="{Binding Exporting, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding Status, Converter={StaticResource NotEmpty}}" />
        </local:ClipCreatorPanel>
    </ScrollViewer>
</UserControl>
