<!-- The Library: search and filters, banner, command bar, then one virtualized list; the page holds the selection. -->
<UserControl x:Class="Encore.App.Library.LibraryView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Encore.App.Library"
             xmlns:theme="clr-namespace:Encore.App.Theme"
             PreviewKeyDown="OnViewPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:TrueToCollapsedConverter x:Key="Hidden" />
        <theme:EmptyToCollapsedConverter x:Key="NotEmpty" />
        <local:LibraryMetaConverter x:Key="Meta" />
        <DataTemplate DataType="{x:Type local:LibraryGroupHeader}">
            <ContentControl Content="{Binding Name}" Style="{DynamicResource EncoreLibraryGroupHeaderStyle}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:LibraryRow}">
            <Grid>
                <Border Style="{DynamicResource EncoreLibraryRowStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource EncoreLibrarySelectionBarStyle}" />
                        <!-- The thumbnail, or the generic video glyph until the shell has one; the length on it. -->
                        <Grid>
                            <Border Style="{DynamicResource EncoreLibraryThumbnailStyle}">
                                <Path Style="{DynamicResource EncoreLibraryPlaceholderGlyphStyle}" />
                            </Border>
                            <Border Style="{DynamicResource EncoreLibraryThumbnailImageStyle}"
                                    Visibility="{Binding HasThumbnail, Converter={StaticResource Visible}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Style="{DynamicResource EncoreLibraryLengthBadgeStyle}">
                                <TextBlock Style="{DynamicResource EncoreLibraryLengthTextStyle}" Text="{Binding Length}" />
                            </Border>
                            <!-- A Recording's or Monitor Recording's kind, top left; a Clip shows none. -->
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Style="{DynamicResource EncoreLibraryLengthBadgeStyle}"
                                    Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
                                <TextBlock Style="{DynamicResource EncoreLibraryLengthTextStyle}" Text="{Binding Badge}" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <!-- The name, or its inline editor while renaming: Enter or leaving commits, Escape cancels. -->
                            <Grid>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{DynamicResource EncoreLibraryNameStyle}"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding Path}" />
                                </Border>
                                <TextBox IsVisibleChanged="OnRenameVisibleChanged"
                                         KeyDown="OnRenameKeyDown"
                                         LostFocus="OnRenameLostFocus"
                                         Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource Visible}}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                            <TextBlock Style="{DynamicResource EncoreLibraryMetaStyle}">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource Meta}">
                                        <Binding Path="Game" />
                                        <Binding Path="Date" />
                                        <Binding Path="Size" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Border Style="{DynamicResource EncoreLibraryLockPillStyle}"
                                    Visibility="{Binding IsLocked, Converter={StaticResource Visible}}">
                                <TextBlock Style="{DynamicResource EncoreLibraryLockTextStyle}" Text="{Binding Lock, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                        <!-- The star follows the snapshot: a click only sends library.setFavourite, and leaves the selection. -->
                        <local:StarToggle Grid.Column="2"
                                          AutomationProperties.Name="Favourite"
                                          Command="{Binding FavouriteCommand}"
                                          IsChecked="{Binding IsFavourite, Mode=OneWay}"
                                          Style="{DynamicResource EncoreStarToggleStyle}"
                                          ToolTip="Favourite" />
                    </Grid>
                </Border>
                <Border Style="{DynamicResource EncoreLibraryFocusRingStyle}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <!-- The list, or the drill-in's player page in its place; the list is hidden, not unloaded, so its scroll and focus survive. -->
    <Grid>
        <local:PlayerView x:Name="PlayerContent"
                          DataContext="{Binding Playback.Player}"
                          Visibility="{Binding Converter={StaticResource NotEmpty}}" />
        <local:ClipCreatorView x:Name="CreatorContent"
                               DataContext="{Binding Playback.Creator}"
                               Visibility="{Binding Converter={StaticResource NotEmpty}}" />
        <DockPanel x:Name="ListContent" Visibility="{Binding DrillIn.IsOpen, Converter={StaticResource Hidden}}">
            <!-- The first-use tips, at the top until the user closes them once. -->
            <ContentControl x:Name="Tips"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,12"
                            DataContext="{Binding Tips}"
                            Style="{DynamicResource EncoreInfoBarTipStyle}"
                            Visibility="{Binding IsShown, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Control Width="32"
                             Height="32"
                             Margin="0,2,12,0"
                             VerticalAlignment="Top"
                             Style="{DynamicResource EncoreMarkStyle}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="{DynamicResource SubtitleTextBlockFontSize}" FontWeight="SemiBold" Text="Keep the moment." />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                            <Run Text="While you play, Rewind keeps the last " /><Run Text="{Binding ClipLength, Mode=OneWay}" /><Run
                                Text=" ready. Press " /><Run FontWeight="SemiBold" Text="{Binding SaveKey, Mode=OneWay}" /><Run
                                Text=" to save it as a Clip." />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="Want the whole match? Allow Recordings for the game on its page in Games, then press " /><Run
                                FontWeight="SemiBold"
                                Text="{Binding RecordKey, Mode=OneWay}" /><Run Text="." />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0">
                            <Hyperlink Command="{Binding ChangeHotkeysCommand}"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">Change hotkeys</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close tips"
                            Command="{Binding CloseCommand}"
                            Content="✕"
                            Style="{DynamicResource EncoreLibraryClearSelectionButtonStyle}"
                            ToolTip="Close" />
                </Grid>
            </ContentControl>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <!-- Each caption stays with its combo when the row wraps. -->
                <!-- Search: a text box with a leading glyph, a hint while empty and a clear button while it has text. -->
                <Grid MinWidth="200" Margin="0,0,12,4">
                    <TextBox x:Name="SearchBox"
                             Padding="30,5,30,6"
                             HorizontalContentAlignment="Left"
                             TextAlignment="Left"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search by name"
                             PreviewKeyDown="OnSearchPreviewKeyDown"
                             Text="{Binding List.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                    <TextBlock Style="{DynamicResource EncoreLibrarySearchGlyphStyle}" Text="&#xE721;" />
                    <!-- The hint shows only while the box itself is empty, not waiting for the delayed search. -->
                    <ContentControl Focusable="False" IsHitTestVisible="False">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <TextBlock Style="{DynamicResource EncoreLibrarySearchHintStyle}" Text="Search by name" />
                    </ContentControl>
                    <!-- The clear button follows the box's own text, not the delayed search. -->
                    <ContentControl Focusable="False" HorizontalAlignment="Right">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <Button AutomationProperties.Name="Clear search"
                                Click="OnClearSearchClick"
                                Content="&#xE711;"
                                Style="{DynamicResource EncoreLibrarySearchClearStyle}"
                                ToolTip="Clear search" />
                    </ContentControl>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource EncoreLibraryFilterCaptionStyle}" Text="Group by" />
                    <ComboBox MinWidth="80"
                              Margin="0,0,12,4"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding List.GroupOptions}"
                              SelectedValue="{Binding List.GroupBy}"
                              SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource EncoreLibraryFilterCaptionStyle}" Text="Sort" />
                    <ComboBox MinWidth="130"
                              Margin="0,0,12,4"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding List.SortOptions}"
                              SelectedValue="{Binding List.Sort}"
                              SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource EncoreLibraryFilterCaptionStyle}" Text="Game" />
                    <ComboBox MinWidth="140"
                              Margin="0,0,12,4"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding List.Games}"
                              SelectedItem="{Binding List.SelectedGame}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource EncoreLibraryFilterCaptionStyle}" Text="Date" />
                    <ComboBox MinWidth="110"
                              Margin="0,0,12,4"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding List.DateOptions}"
                              SelectedValue="{Binding List.DateFilter}"
                              SelectedValuePath="Value" />
                </StackPanel>
                <ToggleButton Margin="0,0,0,4"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Favourites only"
                              Content="★ Favourites only"
                              IsChecked="{Binding List.FavouritesOnly, Mode=TwoWay}" />
            </WrapPanel>
            <ContentControl x:Name="Banner"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,8"
                            Style="{DynamicResource EncoreInfoBarCautionStyle}"
                            Visibility="{Binding Banner.IsCleanupBlocked, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding Banner.AcknowledgeCommand}"
                            Content="Acknowledge"
                            DockPanel.Dock="Right" />
                    <TextBlock VerticalAlignment="Center"
                               Text="The Library index couldn't be read, so it was rebuilt from the Clips folder. Cleanup is off until you acknowledge this."
                               TextWrapping="Wrap" />
                </DockPanel>
            </ContentControl>
            <TextBlock DockPanel.Dock="Top"
                       Style="{DynamicResource EncoreLibraryActionErrorStyle}"
                       Text="{Binding Actions.ActionError}"
                       Visibility="{Binding Actions.HasActionError, Converter={StaticResource Visible}}" />
            <!-- The command bar: the summary with nothing selected, else the count and the actions. Always 40 px. -->
            <Border x:Name="CommandBar"
                    DockPanel.Dock="Top"
                    Style="{DynamicResource EncoreLibraryCommandBarStyle}"
                    Visibility="{Binding ShowsCommandBar, Converter={StaticResource Visible}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selection.HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{DynamicResource EncoreLibraryBarTextStyle}" Text="{Binding List.SummaryText}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{DynamicResource EncoreLibraryBarCaptionStyle}"
                                   Text="Click to select. Ctrl or Shift selects more." />
                    </StackPanel>
                    <DockPanel Visibility="{Binding Selection.HasSelection, Converter={StaticResource Visible}}">
                        <Button AutomationProperties.Name="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Content="✕"
                                DockPanel.Dock="Right"
                                Style="{DynamicResource EncoreLibraryClearSelectionButtonStyle}"
                                ToolTip="Clear selection (Esc)" />
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0" Orientation="Horizontal">
                            <TextBlock x:Name="SelectionCount"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{DynamicResource EncoreLibraryBarCountStyle}"
                                       Text="{Binding Actions.SelectionText}" />
                            <TextBlock Style="{DynamicResource EncoreLibraryBarCaptionStyle}" Text="{Binding Selection.HiddenText}" />
                        </StackPanel>
                        <local:LibraryOverflowPanel x:Name="Actions" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Command="{Binding CreateClipCommand}"
                                    Content="Create clip"
                                    Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <Button VerticalAlignment="Center"
                                    Command="{Binding PlayCommand}"
                                    Content="Play"
                                    Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <Button VerticalAlignment="Center"
                                    Command="{Binding FavouriteSelectionCommand}"
                                    Content="{Binding Actions.FavouriteLabel}" />
                            <Button VerticalAlignment="Center" Command="{Binding CopyCommand}" Content="Copy" />
                            <Button local:LibraryOverflowPanel.Overflows="True"
                                    VerticalAlignment="Center"
                                    Command="{Binding CopyToFolderCommand}"
                                    Content="Copy to folder…" />
                            <Button local:LibraryOverflowPanel.Overflows="True"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenCommand}"
                                    Content="Open in default player"
                                    Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <Button local:LibraryOverflowPanel.Overflows="True"
                                    VerticalAlignment="Center"
                                    Command="{Binding ShowInExplorerCommand}"
                                    Content="Show in Explorer" />
                            <Button VerticalAlignment="Center"
                                    Command="{Binding RenameCommand}"
                                    Content="Rename"
                                    Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <Button VerticalAlignment="Center"
                                    Command="{Binding DeleteCommand}"
                                    Content="Delete"
                                    ToolTip="{Binding Actions.DeleteToolTip}"
                                    ToolTipService.ShowOnDisabled="True" />
                            <Button local:LibraryOverflowPanel.IsMore="True"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="More"
                                    Click="OnMoreClick"
                                    Content="More ⋯">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding CopyToFolderCommand}" Header="Copy to folder…" />
                                        <MenuItem Command="{Binding ShowInExplorerCommand}" Header="Show in Explorer" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </local:LibraryOverflowPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <Grid>
                <!-- One virtualized list of headers and rows; it scrolls itself, so nothing wraps it in a ScrollViewer. -->
                <ListBox x:Name="List"
                         ContextMenuOpening="OnListContextMenuOpening"
                         GotKeyboardFocus="OnListGotKeyboardFocus"
                         ItemContainerStyle="{DynamicResource EncoreLibraryItemContainerStyle}"
                         ItemsSource="{Binding List.Entries}"
                         PreviewKeyDown="OnListPreviewKeyDown"
                         PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="OnListPreviewMouseRightButtonDown"
                         Style="{DynamicResource EncoreLibraryListStyle}">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding CreateClipCommand}"
                                      Header="Create clip"
                                      Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <MenuItem Command="{Binding PlayCommand}"
                                      Header="Play"
                                      InputGestureText="Enter"
                                      Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <MenuItem Command="{Binding OpenCommand}"
                                      Header="Open in default player"
                                      Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <MenuItem Command="{Binding FavouriteSelectionCommand}" Header="{Binding Actions.FavouriteLabel}" />
                            <MenuItem Command="{Binding CopyCommand}" Header="Copy" InputGestureText="Ctrl+C" />
                            <MenuItem Command="{Binding CopyToFolderCommand}" Header="Copy to folder…" />
                            <MenuItem Command="{Binding ShowInExplorerCommand}" Header="Show in Explorer" />
                            <Separator />
                            <MenuItem Command="{Binding RenameCommand}"
                                      Header="Rename"
                                      InputGestureText="F2"
                                      Visibility="{Binding Selection.IsSingle, Converter={StaticResource Visible}}" />
                            <MenuItem Command="{Binding DeleteCommand}"
                                      Header="Delete"
                                      InputGestureText="Del"
                                      ToolTip="{Binding Actions.DeleteToolTip}"
                                      ToolTipService.ShowOnDisabled="True" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <!-- A search that matches nothing says so; a filter that matches nothing shows an empty list. -->
                <TextBlock x:Name="NoResultsMessage"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding List.NoResultsText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding List.NoResultsText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- An empty Library, with no filter or search: one quiet line, not a card. -->
                <TextBlock x:Name="EmptyMessage"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource BodyTextBlockFontSize}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No Clips or Recordings yet."
                           Visibility="{Binding ShowsEmptyMessage, Converter={StaticResource Visible}}" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
