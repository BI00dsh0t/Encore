<app:ShellWindow x:Class="Encore.App.Library.ClipExportDialog" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:app="clr-namespace:Encore.App" xmlns:theme="clr-namespace:Encore.App.Theme"
 Width="440" MaxHeight="720" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="{Binding ExportLabel}">
 <app:ShellWindow.Resources><BooleanToVisibilityConverter x:Key="Visible" /></app:ShellWindow.Resources>
 <Grid><Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="8"><Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" /></Border.Effect><DockPanel KeyboardNavigation.TabNavigation="Cycle">
  <Border DockPanel.Dock="Bottom" Padding="0,19,0,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{DynamicResource RbClipButtonStyle}" Content="Cancel" IsCancel="True" MinWidth="88" Click="Cancel" Margin="0,0,8,0" />
    <Button x:Name="SaveButton" Content="{Binding SaveLabel}" IsEnabled="{Binding CanSave}" IsDefault="True" MinWidth="110" Style="{DynamicResource RbClipPrimaryButtonStyle}" Click="Save" />
   </StackPanel>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0">
   <DockPanel Margin="0,0,0,3"><Button DockPanel.Dock="Right" Style="{DynamicResource RbClipToolButtonStyle}" Click="Cancel" ToolTip="Close export options" AutomationProperties.Name="Close export options"><Path Style="{DynamicResource RbClipIconStyle}" Data="M 3,3 L 13,13 M 13,3 L 3,13" /></Button><TextBlock Text="{Binding ExportLabel}" FontSize="19" FontWeight="Medium" VerticalAlignment="Center" /></DockPanel>
   <TextBlock Text="{Binding FormatSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
   <Label Foreground="{DynamicResource TextFillColorPrimaryBrush}" Content="Output name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
   <TextBox Style="{DynamicResource RbClipInputStyle}" x:Name="NameBox" Text="{Binding ExportName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Export output name" />
   <TextBlock Text="Enter a file or folder name without path separators." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ValidExportName}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <DockPanel Margin="0,16,0,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{DynamicResource RbClipButtonStyle}" Content="All" Command="{Binding AllTracksCommand}" Margin="0,0,6,0" /><Button Style="{DynamicResource RbClipButtonStyle}" Content="None" Command="{Binding NoTracksCommand}" /></StackPanel><TextBlock Text="Include audio tracks" VerticalAlignment="Center" /></DockPanel>
   <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Tracks}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Included}" AutomationProperties.Name="{Binding Name}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <WrapPanel Margin="0,12,0,8" Visibility="{Binding MultipleTracks, Converter={StaticResource Visible}}"><RadioButton Content="{Binding SeparateLabel}" IsChecked="{Binding Separate}" GroupName="OutputMode" Margin="0,0,12,4" /><RadioButton Content="Combined mix" IsChecked="{Binding Mix}" GroupName="OutputMode" Margin="0,0,0,4" /></WrapPanel>
   <TextBlock Text="{Binding OutputSummary}" TextWrapping="Wrap" Margin="0,8,0,12" />
   <Separator />
   <TextBlock Text="{Binding DurationText}" Margin="0,8,0,4" />
   <TextBlock Text="{Binding EffectiveText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
  </StackPanel></ScrollViewer>
 </DockPanel></Border></Grid>
</app:ShellWindow>
