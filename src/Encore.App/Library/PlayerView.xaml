<!-- The in-app player's page: the video, a thin seek bar and one control row. Keys bubble, so a control's own keys win. -->
<UserControl x:Class="Encore.App.Library.PlayerView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Encore.App.Theme"
             xmlns:local="clr-namespace:Encore.App.Library"
             KeyDown="OnKeyDown" x:Name="PlayerRoot">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <theme:TrueToCollapsedConverter x:Key="HideEditor" />
        <local:ClipPlayerVisibilityConverter x:Key="ClipPlayerVisible" />
        <theme:EmptyToCollapsedConverter x:Key="NotEmpty" />
    </UserControl.Resources>
    <Border x:Name="Backdrop" Style="{DynamicResource EncorePlayerBackdropStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="Picture" Stretch="Uniform" />
            <TextBlock MaxWidth="560"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{DynamicResource EncorePlayerMessageStyle}"
                       Text="{Binding Message}"
                       Visibility="{Binding Message, Converter={StaticResource NotEmpty}}" />

            <!-- The bar: under the video, or over its bottom edge in full screen (EncorePlayerBarStyle). -->
            <Border x:Name="Bar" Grid.Row="1" Style="{DynamicResource EncorePlayerBarStyle}">
                <StackPanel>
                    <Slider x:Name="SeekBar"
                            AutomationProperties.Name="Seek"
                            IsMoveToPointEnabled="True"
                            LargeChange="30"
                            Maximum="{Binding DurationSeconds}"
                            Minimum="0"
                            SmallChange="5"
                            Style="{DynamicResource EncorePlayerSeekStyle}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            >
                        <Slider.Visibility><MultiBinding Converter="{StaticResource ClipPlayerVisible}"><Binding Path="CanSeek" /><Binding Path="IsClipEditor" ElementName="PlayerRoot" /></MultiBinding></Slider.Visibility>
                    </Slider>
                    <DockPanel LastChildFill="False">
                        <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Height" Value="48" /><Style.Triggers><DataTrigger Binding="{Binding IsClipEditor, ElementName=PlayerRoot}" Value="True"><Setter Property="Height" Value="32" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="PlayPause"
                                    AutomationProperties.Name="{Binding PlayPauseLabel}"
                                    Command="{Binding PlayPauseCommand}"
                                    Content="{Binding PlayPauseGlyph}"
                                    ToolTip="{Binding PlayPauseLabel}" Style="{DynamicResource EncorePlayerIconButtonStyle}"
                                    Visibility="{Binding IsClipEditor, ElementName=PlayerRoot, Converter={StaticResource HideEditor}}" />
                            <!-- The speaker; its slider slides out while the pointer or keyboard focus is in this group. -->
                            <StackPanel x:Name="VolumeGroup"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasControls, Converter={StaticResource Visible}}">
                                <Button x:Name="Mute"
                                        AutomationProperties.Name="{Binding MuteName}"
                                        Command="{Binding MuteCommand}"
                                        Content="{Binding MuteGlyph}"
                                        Style="{DynamicResource EncorePlayerIconButtonStyle}"
                                        ToolTip="{Binding MuteName}" />
                                <Slider x:Name="VolumeBar"
                                        Width="72"
                                        Margin="6,0,6,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Volume"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="0.2"
                                        Maximum="1"
                                        Minimum="0"
                                        SmallChange="0.05"
                                        Style="{DynamicResource EncorePlayerVolumeStyle}"
                                        Value="{Binding Volume, Mode=TwoWay}"
                                        Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="Time"
                                       Margin="8,0,0,0"
                                       Text="{Binding TimeText}"
                                       Style="{DynamicResource EncorePlayerTimeStyle}"><TextBlock.Visibility><MultiBinding Converter="{StaticResource ClipPlayerVisible}"><Binding Path="HasControls" /><Binding Path="IsClipEditor" ElementName="PlayerRoot" /></MultiBinding></TextBlock.Visibility></TextBlock>
                            <!-- The missing extension's Store page, then the default player, when it can't play. -->
                            <Button Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenStoreCommand}"
                                    Content="{Binding StoreLinkText}"
                                    Visibility="{Binding HasStoreLink, Converter={StaticResource Visible}}" />
                            <Button Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenInDefaultPlayerCommand}"
                                    Content="Open in default player"
                                    Visibility="{Binding ShowsDefaultPlayerAction, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Create clip" Command="{Binding CreateClipCommand}" Margin="6,0" Visibility="{Binding HasCreateClip, Converter={StaticResource Visible}}" />
                            <ToggleButton x:Name="Gear"
                                          AutomationProperties.Name="Player settings"
                                          Click="OnGearClick"
                                          Content="&#xE713;"
                                          Style="{DynamicResource EncorePlayerIconToggleStyle}"
                                          ToolTip="Player settings"
                                          Visibility="{Binding HasControls, Converter={StaticResource Visible}}" />
                            <Button x:Name="FullScreen"
                                    AutomationProperties.Name="{Binding FullScreenName}"
                                    Command="{Binding FullScreenCommand}"
                                    Content="{Binding FullScreenGlyph}"
                                    Style="{DynamicResource EncorePlayerIconButtonStyle}"
                                    Visibility="{Binding SupportsFullScreen, Converter={StaticResource Visible}}"
                                    ToolTip="{Binding FullScreenName}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
