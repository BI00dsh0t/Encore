<app:ShellWindow x:Class="Encore.App.PromptDialog"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:app="clr-namespace:Encore.App"
                 Width="440"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- The App's one dialog: caption and message, then Yes (the default) and No. It keeps no resources of its own. -->
    <DockPanel>
        <Border x:Name="ButtonBar"
                DockPanel.Dock="Bottom"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource RbDialogButtonBarPadding}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="YesButton" MinWidth="96" Content="Yes" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnYes" />
                <Button x:Name="NoButton" MinWidth="96" Margin="8,0,0,0" Content="No" Click="OnNo" />
            </StackPanel>
        </Border>
        <Grid x:Name="Body" Margin="{DynamicResource RbDialogContentPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Glyph"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="20"
                       Visibility="Collapsed" />
            <TextBlock x:Name="CaptionText"
                       Grid.Column="1"
                       Style="{DynamicResource SubtitleTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Margin="0,12,0,0"
                       Style="{DynamicResource BodyTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</app:ShellWindow>
