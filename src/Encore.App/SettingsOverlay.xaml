<!-- Settings over the Main App window: a scrim, and a centred panel with the sections on the left and the page on the right. -->
<UserControl x:Class="Encore.App.SettingsOverlay"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Encore.App"
             xmlns:theme="clr-namespace:Encore.App.Theme"
             x:Name="Overlay"
             AutomationProperties.Name="Settings"
             KeyDown="OnKeyDown"
             Visibility="Collapsed">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="EncoreSettingsVisible" />
        <theme:TrueToCollapsedConverter x:Key="EncoreSettingsHidden" />
    </UserControl.Resources>
    <!-- The panel takes nine tenths of the window, up to 1040 by 680, centred. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="90*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="90*" />
            <ColumnDefinition Width="5*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Scrim"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                MouseLeftButtonDown="OnScrimClick" />

        <Grid x:Name="Card"
              Grid.Row="1"
              Grid.Column="1"
              MaxWidth="1040"
              MaxHeight="680"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" />
            </Grid.RenderTransform>
            <!-- The shadow sits on its own layer, so the panel's text keeps its ClearType. -->
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="{DynamicResource OverlayCornerRadius}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      Direction="270"
                                      Opacity="0.35"
                                      ShadowDepth="8" />
                </Border.Effect>
            </Border>
            <Border x:Name="Panel"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}"
                    KeyboardNavigation.ControlTabNavigation="None"
                    KeyboardNavigation.TabNavigation="Cycle"
                    SizeChanged="OnPanelSizeChanged">
                <Grid x:Name="PanelContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SectionsColumn" Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{DynamicResource EncoreShellNavLayerStyle}" />
                    <!-- The sections: arrows move through them, Tab goes on into the page. -->
                    <ListBox x:Name="Sections"
                             Margin="{DynamicResource EncoreNavPanePadding}"
                             Padding="0,12,0,0"
                             AutomationProperties.Name="Settings sections"
                             Background="{DynamicResource SubtleFillColorTransparentBrush}"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             ItemContainerStyle="{DynamicResource EncoreNavItemStyle}"
                             ItemsSource="{Binding Sections, Mode=OneTime}"
                             KeyDown="OnSectionKeyDown"
                             PreviewMouseLeftButtonUp="OnSectionClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             SelectionMode="Single"
                             TextSearch.TextPath="Title" />

                    <Border Grid.Column="1" Style="{DynamicResource EncoreShellContentLayerStyle}">
                        <DockPanel Margin="{DynamicResource EncorePagePadding}">
                            <Grid x:Name="PageHeader" Margin="0,0,40,0" DockPanel.Dock="Top">
                                <ContentControl x:Name="PageTitle"
                                                Content="{Binding Title}"
                                                Style="{DynamicResource EncorePageTitleStyle}"
                                                Visibility="{Binding IsDrilledIn, Converter={StaticResource EncoreSettingsHidden}}" />
                                <app:DrillInHeader x:Name="Breadcrumb"
                                                   DataContext="{Binding CurrentDrillIn}"
                                                   Visibility="{Binding DataContext.IsDrilledIn,
                                                                        ElementName=Overlay,
                                                                        Converter={StaticResource EncoreSettingsVisible}}" />
                            </Grid>
                            <!-- The page's last refusal or reload note; the bar's own style hides it while empty. -->
                            <ContentControl x:Name="PageMessage"
                                            Margin="0,12,0,0"
                                            Content="{Binding SelectedPage.Message}"
                                            DockPanel.Dock="Bottom"
                                            Style="{DynamicResource EncoreSettingsPageMessageStyle}" />
                            <ContentControl x:Name="Page"
                                            Margin="0,12,0,0"
                                            Content="{Binding CurrentView}"
                                            Focusable="False" />
                        </DockPanel>
                    </Border>
                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Margin="0,12,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close Settings"
                            Command="{Binding CloseCommand}"
                            Content="✕"
                            Style="{DynamicResource EncoreLibraryClearSelectionButtonStyle}"
                            ToolTip="Close (Esc)" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
