<UserControl x:Class="Encore.App.Settings.GamePageView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Encore.App.Theme"
             AutomationProperties.Name="{Binding Name}"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- An inheritance section: its header with the chip, then the main value as text or the game's editor. -->
        <DataTemplate x:Key="InheritedSectionTemplate">
            <StackPanel Margin="0,0,0,24">
                <DockPanel Margin="0,0,0,8">
                    <Border DockPanel.Dock="Right" Style="{DynamicResource EncoreInheritChipStyle}">
                        <TextBlock Text="{Binding Chip}" />
                    </Border>
                    <ContentControl VerticalAlignment="Center" Content="{Binding Title}" Style="{DynamicResource EncoreSectionHeaderStyle}" />
                </DockPanel>
                <Border Style="{DynamicResource EncoreCardStyle}">
                    <Grid>
                        <DockPanel Visibility="{Binding UsesMain, Converter={StaticResource Visible}}">
                            <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Margin="12,0,12,0" Command="{Binding ChangeCommand}" Content="Change for this game" />
                                <TextBlock VerticalAlignment="Center">
                                    <Hyperlink Command="{Binding EditMainCommand}" Style="{DynamicResource EncoreGamesLinkStyle}">Edit the main setting</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding Summary}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding IsChanged, Converter={StaticResource Visible}}">
                            <ContentPresenter Content="{Binding Editor}" />
                            <TextBlock Style="{DynamicResource EncoreSettingsHelpTextStyle}"
                                       Text="Changes apply from this game's next session, or right after its next saved Clip." />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ResetCommand}"
                                    Content="Reset to the main setting" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <theme:SettingsContent Style="{DynamicResource EncoreSettingsContentStyle}">
            <!-- The header: the name, renamed inline (F2), and the program's location. -->
            <DockPanel Margin="0,0,0,20">
                <Border Width="48" Height="48" DockPanel.Dock="Left" Style="{DynamicResource EncoreGameIconTileStyle}">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Text="{Binding Initial}" />
                        <Image Source="{Binding Icon}" Stretch="Uniform" Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
                    </Grid>
                </Border>
                <StackPanel>
                    <TextBox x:Name="NameBox"
                             HorizontalAlignment="Left"
                             MinWidth="240"
                             AutomationProperties.Name="Game name"
                             FontSize="20"
                             FontWeight="SemiBold"
                             KeyDown="OnNameKeyDown"
                             LostKeyboardFocus="OnNameLostFocus"
                             ToolTip="Rename (F2)" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock VerticalAlignment="Center" Style="{DynamicResource EncoreGameCaptionStyle}">
                            <Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" · Program: " /><Run Text="{Binding ProgramPath, Mode=OneTime}" />
                        </TextBlock>
                        <Button Margin="12,0,0,0" Command="{Binding ShowProgramCommand}" Content="Show in Explorer" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>

            <HeaderedContentControl Header="Capture" Style="{DynamicResource EncoreSettingsSectionStyle}">
                <StackPanel>
                    <CheckBox Content="Capture this game" FontSize="{DynamicResource BodyTextBlockFontSize}" IsChecked="{Binding Capture}" />
                    <TextBlock Style="{DynamicResource EncoreSettingsHelpTextStyle}" Text="When off, Encore won't capture it or save Clips while it runs." />
                </StackPanel>
            </HeaderedContentControl>

            <ContentControl Content="{Binding Clips}" ContentTemplate="{StaticResource InheritedSectionTemplate}" Focusable="False" />

            <HeaderedContentControl Header="Recordings" Style="{DynamicResource EncoreSettingsSectionStyle}">
                <StackPanel>
                    <CheckBox Content="Allow Recordings in this game" FontSize="{DynamicResource BodyTextBlockFontSize}" IsChecked="{Binding RecordingsEnabled}" />
                    <TextBlock Style="{DynamicResource EncoreSettingsHelpTextStyle}" Text="{Binding RecordingsHelp}" />
                </StackPanel>
            </HeaderedContentControl>

            <ContentControl Content="{Binding Video}" ContentTemplate="{StaticResource InheritedSectionTemplate}" Focusable="False" />
            <ContentControl Content="{Binding AudioTracks}" ContentTemplate="{StaticResource InheritedSectionTemplate}" Focusable="False" />

            <HeaderedContentControl Header="Files" Style="{DynamicResource EncoreSettingsSectionStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource EncoreSettingsLabelStyle}" Text="Saved in" />
                    <TextBox Grid.Column="1"
                             Margin="0,4"
                             AutomationProperties.Name="Saved in"
                             Background="{DynamicResource ControlFillColorDisabledBrush}"
                             IsReadOnly="True"
                             Text="{Binding FolderText, Mode=OneWay}"
                             ToolTip="{Binding FolderText, Mode=OneWay}" />
                    <Button Grid.Column="2" Margin="8,4,0,4" Command="{Binding OpenFolderCommand}" Content="Open in Explorer" />
                    <TextBlock Grid.Row="1" Style="{DynamicResource EncoreSettingsLabelStyle}" Text="File names look like" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4" VerticalAlignment="Center" Text="{Binding FileNameExample}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                               Style="{DynamicResource EncoreSettingsHelpTextStyle}"
                               Text="Renaming the game changes new file names only; the folder stays." />
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Header="Added by hand"
                                    Style="{DynamicResource EncoreSettingsSectionStyle}"
                                    Visibility="{Binding IsManual, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Button HorizontalAlignment="Left" Command="{Binding StopDetectingCommand}" Content="Stop detecting it by hand" />
                    <TextBlock Style="{DynamicResource EncoreSettingsHelpTextStyle}"
                               Text="It's still found if it runs fullscreen or Windows marks it as a game." />
                </StackPanel>
            </HeaderedContentControl>
        </theme:SettingsContent>
    </ScrollViewer>
</UserControl>
