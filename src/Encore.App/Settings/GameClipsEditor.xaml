<UserControl x:Class="Encore.App.Settings.GameClipsEditor"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A game's own Clip length: the Clips page's row, on a game-scoped Clips view model. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{DynamicResource RbSettingsLabelStyle}" Text="Save the last" />
        <TextBox Grid.Column="1" MinWidth="80" Margin="0,4" AutomationProperties.Name="Clip length in seconds" Text="{Binding BufferWindowText}" />
        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="seconds" />
    </Grid>
</UserControl>
