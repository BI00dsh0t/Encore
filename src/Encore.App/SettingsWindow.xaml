<!-- The Settings window: a section per page down the left, the page on the right with its header and message bar. Colours are tokens. -->
<app:ShellWindow x:Class="Encore.App.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:app="clr-namespace:Encore.App"
                 xmlns:theme="clr-namespace:Encore.App.Theme"
                 x:Name="SettingsShell"
                 Title="Settings"
                 Width="1040"
                 Height="680"
                 MinWidth="640"
                 MinHeight="400"
                 ShowInTaskbar="False"
                 KeyDown="OnKeyDown"
                 MouseUp="OnMouseUp">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="EncoreSettingsVisible" />
            <theme:TrueToCollapsedConverter x:Key="EncoreSettingsHidden" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{DynamicResource EncoreShellNavLayerStyle}" />
        <!-- The sections: arrows move through them, Tab goes on into the page. -->
        <ListBox x:Name="Sections"
                 Margin="{DynamicResource EncoreNavPanePadding}"
                 Padding="0,12,0,0"
                 AutomationProperties.Name="Settings sections"
                 Background="{DynamicResource SubtleFillColorTransparentBrush}"
                 BorderThickness="0"
                 FocusVisualStyle="{x:Null}"
                 ItemContainerStyle="{DynamicResource EncoreNavItemStyle}"
                 ItemsSource="{Binding Sections, Mode=OneTime}"
                 KeyDown="OnSectionKeyDown"
                 PreviewMouseLeftButtonUp="OnSectionClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 SelectionMode="Single"
                 TextSearch.TextPath="Title" />

        <Border Grid.Column="1" Style="{DynamicResource EncoreShellContentLayerStyle}">
            <DockPanel Margin="{DynamicResource EncorePagePadding}">
                <Grid x:Name="PageHeader" DockPanel.Dock="Top">
                    <ContentControl x:Name="PageTitle"
                                    Content="{Binding Title}"
                                    Style="{DynamicResource EncorePageTitleStyle}"
                                    Visibility="{Binding IsDrilledIn, Converter={StaticResource EncoreSettingsHidden}}" />
                    <app:DrillInHeader x:Name="Breadcrumb"
                                       DataContext="{Binding CurrentDrillIn}"
                                       Visibility="{Binding DataContext.IsDrilledIn,
                                                            ElementName=SettingsShell,
                                                            Converter={StaticResource EncoreSettingsVisible}}" />
                </Grid>
                <!-- The page's last refusal or reload note; the bar's own style hides it while empty. -->
                <ContentControl x:Name="PageMessage"
                                Margin="0,12,0,0"
                                Content="{Binding SelectedPage.Message}"
                                DockPanel.Dock="Bottom"
                                Style="{DynamicResource EncoreSettingsPageMessageStyle}" />
                <ContentControl x:Name="Page"
                                Margin="0,12,0,0"
                                Content="{Binding CurrentView}"
                                Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</app:ShellWindow>
