<!-- The shell's styles under Gaming dark: the same keys as ShellFluent.xaml; uppercase comes from a converter. -->
<ResourceDictionary x:Class="Encore.App.Theme.ShellGamingDark"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:Encore.App.Theme">

    <theme:UppercaseConverter x:Key="EncoreShellUppercase" />

    <!-- Nav items run the pane's full width, flush with its edge. -->
    <Thickness x:Key="EncoreNavPanePadding">0,0,0,8</Thickness>
    <Thickness x:Key="EncoreNavBrandMargin">16,16,16,24</Thickness>

    <!-- The nav pane sits a step above bg-base with a divider on its right edge, so it reads as its own surface. -->
    <Style x:Key="EncoreShellNavLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The content stays on bg-base; the nav layer's edge marks the boundary. -->
    <Style x:Key="EncoreShellContentLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    </Style>

    <!-- The status header's state line: body-strong, uppercase. -->
    <Style x:Key="EncoreStatusStateStyle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EncoreShellUppercase}}" TextWrapping="Wrap" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Settings section label: caption, uppercase, text-disabled, so it never reads as a nav item. -->
    <ControlTemplate x:Key="EncoreNavSectionTemplate" TargetType="ListBoxItem">
        <TextBlock Margin="16,16,16,4"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorDisabledBrush}"
                   Text="{Binding Title, Converter={StaticResource EncoreShellUppercase}}" />
    </ControlTemplate>

    <!-- Nav item: text-secondary, uppercase; selected is accent-subtle with a full-height accent bar. -->
    <Style x:Key="EncoreNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="ToolTip" Value="{Binding Title}" />
        <Setter Property="theme:NavPress.Track" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" Background="Transparent" CornerRadius="6" /><Border x:Name="SelectedFill" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.12" CornerRadius="6" Visibility="Collapsed" />
                        <Border x:Name="Pill"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                        <DockPanel x:Name="NavContent" Margin="{TemplateBinding Padding}" LastChildFill="False">
                            <TextBlock x:Name="NavGlyph" DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock x:Name="Label"
                                       DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- An unsaved draft on the page (6 px, accent; square under Gaming dark). -->
                            <Border x:Name="UnsavedDot"
                                    Width="6"
                                    Height="6"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    DockPanel.Dock="Left"
                                    Visibility="Collapsed" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Rail">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" /><Setter Property="Padding" Value="0" /><Setter TargetName="NavContent" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="NavGlyph" Property="Margin" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                            <Setter TargetName="UnsavedDot" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedFill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                        </Trigger>
                        <Trigger Property="theme:NavPress.IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSection}" Value="True">
                <Setter Property="Template" Value="{StaticResource EncoreNavSectionTemplate}" />
                <Setter Property="Height" Value="NaN" />
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </DataTrigger>
            <!-- Below 640 px the pane narrows and long titles trim, so the title shows as a tooltip. -->
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Narrow">
                <Setter Property="ToolTip" Value="{Binding Title}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EncoreSettingsNavStyle" TargetType="ToggleButton"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Height" Value="40" /><Setter Property="Margin" Value="4,8,4,0" /><Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid>
            <Border x:Name="Fill" Background="Transparent" CornerRadius="6" />
            <Border x:Name="Pill" Width="3" Height="16" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Grid><ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource EncoreAccentSubtleBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><DataTrigger Binding="{Binding IsNavigationExpanded}" Value="False"><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="Padding" Value="0" /></DataTrigger></Style.Triggers>
    </Style>
</ResourceDictionary>
