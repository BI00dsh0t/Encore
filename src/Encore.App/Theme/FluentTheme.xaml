<!-- Fluent's side of the token set: only the App keys Fluent has no key for; they follow Windows live. -->
<ResourceDictionary x:Class="Encore.App.Theme.FluentTheme"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="RbAccentSubtleBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
    <!-- The selected Library row: the accent's light tint at a quarter, so even a grey accent reads stronger. -->
    <SolidColorBrush x:Key="RbLibraryRowSelectedBrush" Opacity="0.25" Color="{DynamicResource {x:Static SystemColors.AccentColorLight2Key}}" />
    <SolidColorBrush x:Key="RbRecordBrush" Color="{DynamicResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="RbOverlayCardBrush" Opacity="0.9" Color="{DynamicResource SolidBackgroundFillColorQuarternary}" />

    <CornerRadius x:Key="RbSmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="RbNavItemCornerRadius">4</CornerRadius>

    <!-- The App's type styles. ContentControls, so Gaming dark's versions can uppercase in their template. -->
    <Style x:Key="RbTextStyleBase" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RbSectionHeaderStyle" TargetType="ContentControl" BasedOn="{StaticResource RbTextStyleBase}">
        <Setter Property="FontSize" Value="{DynamicResource BodyTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="RbPageTitleStyle" TargetType="ContentControl" BasedOn="{StaticResource RbTextStyleBase}">
        <Setter Property="FontSize" Value="{DynamicResource TitleTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="RbBrandStyle" TargetType="ContentControl" BasedOn="{StaticResource RbTextStyleBase}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
