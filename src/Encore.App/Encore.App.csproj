<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\encore.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <!-- WPF caches this switch when the first window shows, so it is set at process start to keep Mica off every window. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Encore.App.Tests" />
  </ItemGroup>
  <!-- Core's canvas rule is linked as source, because the App must not reference Core. -->
  <ItemGroup>
    <Compile Include="..\Encore.Core\Monitors\MonitorCanvasRule.cs" Link="Settings\MonitorCanvasRule.cs" />
    <Compile Include="..\Shared\ClipPeakFile.cs" Link="Library\ClipPeakFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Encore.Contracts\Encore.Contracts.csproj" />
    <ProjectReference Include="..\Encore.Platform.Desktop\Encore.Platform.Desktop.csproj" />
    <!-- Build order only: the App never compiles against the engine. -->
    <ProjectReference Include="..\Encore.Engine\Encore.Engine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The App launches the engine from its own folder, so a dev build gets the engine beside it, as the install folder has it. -->
  <Target Name="CopyEngineBesideApp" AfterTargets="Build">
    <MSBuild Projects="..\Encore.Engine\Encore.Engine.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_EngineTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_EngineFile Include="%(_EngineTargetPath.RootDir)%(_EngineTargetPath.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_EngineFile)"
          DestinationFiles="@(_EngineFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_EngineFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
