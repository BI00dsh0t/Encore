<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- A local build's version; the release workflow passes the tag's. -->
    <Version>0.0.0-dev</Version>
    <!-- The app is English only, so the runtime's translated messages stay out of the package. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets GitHub's dependency graph restore these Windows-only projects on its Linux runners; builds still need Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The unused-using check (IDE0005) only runs on build with this on; undocumented members and parameters stay allowed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <FFmpegNativeDir>$(RepoRoot)native\ffmpeg\</FFmpegNativeDir>
  </PropertyGroup>

  <!-- The engine side builds with the trim and AOT analyzers, and their warnings are errors. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests')) and '$(MSBuildProjectName)' != 'Encore.App' and '$(MSBuildProjectName)' != 'Encore.Bench'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
